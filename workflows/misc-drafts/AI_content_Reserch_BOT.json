    {
      "id": "780979de-eaaa-4c03-84b2-691408629585",
      "name": "X Deep Research Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        112
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Run todays deep research pass and return the structured digest for {{ $now.toFormat(\"MMMM d, yyyy\") }}.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a research assistant for an AI content creator who makes tutorials and commentary videos about AI. Using real-time search of X (Twitter) and the web, do a deep research pass on what is happening RIGHT NOW in the AI space (last 24-48 hours only). Step 1 - Find the 3-5 biggest AI news stories or model releases people are actually discussing. For each story provide: headline, why_it_matters, content_angle (one-line tutorial/explainer angle), and source_note (cite X post, article, etc). Step 2 - List 3-5 trending_questions: real confused or curious questions users are asking about these topics. Step 3 - Derive 4-6 content_ideas grounded in that research. For each idea provide: headline, angle (specific unique take), why_now (what made it timely today), suggested_format (short-form reaction, deep-dive tutorial, breakdown thread, etc), and related_story (headline of the top story it connects to, if any). Prioritize signal over noise - ignore low-engagement or unverified rumor posts. Do not invent fake events. If you are not certain something is currently trending, say so explicitly rather than fabricating urgency. Return ONLY structured JSON matching the required schema."
        }
      }
    },
    {
      "id": "98761f3f-286a-4b62-ad46-632760deb490",
      "name": "Grok Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatXAiGrok",
      "typeVersion": 1,
      "position": [
        176,
        336
      ],
      "parameters": {
        "model": "grok-4.20-0309-reasoning",
        "options": {
          "temperature": 0.6
        }
      }
    },
    {
      "id": "fa255891-5a8b-497e-9a1f-77f4d6024b61",
      "name": "Digest Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        368,
        336
      ],
      "parameters": {
        "jsonSchemaExample": "{\"email_subject\":\"AI Content Digest - July 4\",\"top_stories\":[{\"headline\":\"GPT-5 leaked benchmarks spark debate\",\"why_it_matters\":\"Developers are comparing rumored specs against current models\",\"content_angle\":\"Break down what is verified vs rumor\",\"source_note\":\"Trending X thread by @ai_researcher\"}],\"trending_questions\":[\"Is the new model actually better for coding?\"],\"content_ideas\":[{\"headline\":\"GPT-5 rumors explained\",\"angle\":\"Compare leaked benchmarks vs current SOTA models\",\"why_now\":\"High engagement on X in the last 24 hours\",\"suggested_format\":\"short-form reaction video\",\"related_story\":\"GPT-5 leaked benchmarks spark debate\"}]}"
      }
    },
