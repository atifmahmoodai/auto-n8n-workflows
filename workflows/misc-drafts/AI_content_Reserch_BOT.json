            {
              "id": "body",
              "name": "body",
              "value": "=<h2>Top Stories</h2>\n{{ $json.output.top_stories.map(s => \"<b>\" + s.headline + \"</b><br><i>Why:</i> \" + s.why_it_matters + \"<br><i>Angle:</i> \" + s.content_angle + \"<br><i>Source:</i> \" + s.source_note).join(\"<hr>\") }}<h2>Trending Questions</h2>{{ $json.output.trending_questions.map(q => \"&#8226; \" + q).join(\"<br>\") }}<h2>Content Ideas</h2>{{ $json.output.content_ideas.map(i => \"<b>\" + i.headline + \"</b><br>\" + i.angle + \"<br><i>Why now:</i> \" + i.why_now + \"<br><i>Format:</i> \" + i.suggested_format + (i.related_story ? \"<br><i>Related:</i> \" + i.related_story : \"\")).join(\"<hr>\") }}",
