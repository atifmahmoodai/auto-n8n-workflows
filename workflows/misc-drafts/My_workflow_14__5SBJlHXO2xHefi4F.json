    {
      "id": "aa6a7c2f-951e-4914-a63c-1bfd00ff9638",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You have access to the user's Equity portfolio which is in Google Sheet. You also have access to market data. The user has asked you to rebalance their portfolio  with this instruction:\n\n\n{{ $json[\"how would you like to rebalance your portfolio\"] }}\n\nIn order to achieve this:\n1. Read the portfolio from the sheet\n2. Fetch latest prices of the positions\n3. Update the table with the prices\n4. Make decisions on portfolio rebalancing\n5. Update the table with portfolio rebalancing decisions\n6. Read the table again to check the rebalancing achieved the objective. IMPORTANT: you must confirm that you have achieve your goal by reading the spreadsheet.\n7. Make any further changes to improve rebalancing, updating the table\n8. Finally, send an email with trading decisions and concise push notification\n\nAlways use tools until complete. only respond \"OK\" after using all tools when your mission is complete.",
        "options": {
          "maxIterations": 30
        }
      }
    },
