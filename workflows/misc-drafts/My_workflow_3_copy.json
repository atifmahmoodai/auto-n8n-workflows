    {
      "id": "59f085e4-e448-45e4-a16f-af7945f066b7",
      "name": "Calculate Session Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -128
      ],
      "parameters": {
        "jsCode": "// Advanced session analytics calculation\nconst items = $input.all();\n\nif (items.length === 0) {\n  return [];\n}\n\nconst sessionId = items[0].json.sessionId;\nconst totalInteractions = items.length;\n\n// Calculate confidence metrics\nconst confidenceScores = items.map(item => item.json.confidence || 0);\nconst avgConfidence = confidenceScores.reduce((a, b) => a + b, 0) / totalInteractions;\nconst minConfidence = Math.min(...confidenceScores);\nconst maxConfidence = Math.max(...confidenceScores);\n\n// Count actions by type\nconst actionCounts = {};\nitems.forEach(item => {\n  const action = item.json.agentAction || 'unknown';\n  actionCounts[action] = (actionCounts[action] || 0) + 1;\n});\n\n// Count high vs low quality responses\nconst highQualityCount = confidenceScores.filter(score => score >= 0.7).length;\nconst lowQualityCount = totalInteractions - highQualityCount;\n\n// Extract unique tickers processed\nconst allTickers = items\n  .map(item => item.json.tickersProcessed || '')\n  .filter(t => t && t !== 'none')\n  .join(', ')\n  .split(', ')\n  .filter(t => t.trim());\nconst uniqueTickers = [...new Set(allTickers)];\n\n// Calculate session duration\nconst timestamps = items.map(item => new Date(item.json.timestamp));\nconst sessionStart = new Date(Math.min(...timestamps));\nconst sessionEnd = new Date(Math.max(...timestamps));\nconst durationMinutes = (sessionEnd - sessionStart) / 1000 / 60;\n\nreturn [{\n  json: {\n    sessionId,\n    totalInteractions,\n    highQualityResponses: highQualityCount,\n    lowQualityResponses: lowQualityCount,\n    qualityRate: (highQualityCount / totalInteractions * 100).toFixed(2) + '%',\n    avgConfidence: avgConfidence.toFixed(3),\n    minConfidence: minConfidence.toFixed(3),\n    maxConfidence: maxConfidence.toFixed(3),\n    actionBreakdown: actionCounts,\n    uniqueTickersProcessed: uniqueTickers.length,\n    tickersList: uniqueTickers.join(', '),\n    sessionStart: sessionStart.toISOString(),\n    sessionEnd: sessionEnd.toISOString(),\n    durationMinutes: durationMinutes.toFixed(2),\n    timestamp: new Date().toISOString()\n  }\n}];"
      }
    },
