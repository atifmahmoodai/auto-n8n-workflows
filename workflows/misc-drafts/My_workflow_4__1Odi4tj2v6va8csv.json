      "type": "n8n-nodes-base.salesforceTool",
      "typeVersion": 1,
      "position": [
        720,
        720
      ],
      "parameters": {
        "company": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('company', 'Company name of the lead') }}",
        "lastname": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('lastName', 'Last name of the lead') }}",
        "additionalFields": {
          "description": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('description', 'Additional notes about the lead') }}",
          "email": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('email', 'Email address of the lead') }}",
          "firstname": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('firstName', 'First name of the lead') }}",
          "leadSource": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('leadSource', 'Source of the lead (e.g., Website, Referral, Trade Show)') }}",
          "phone": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('phone', 'Phone number of the lead') }}",
          "status": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('status', 'Lead status (e.g., Open, Contacted, Qualified)') }}",
          "title": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('title', 'Job title of the lead') }}"
