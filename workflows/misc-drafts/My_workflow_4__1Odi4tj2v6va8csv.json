    {
      "id": "aca7ae93-640b-481a-a7a6-a9f6f5b8715a",
      "name": "CRM Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        784,
        496
      ],
      "parameters": {
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an enterprise CRM assistant with expertise in sales operations, lead management, and customer relationship workflows.\n\nYou have access to the following professional tools:\n\n1. **Salesforce Lead Tool** - Create new leads in Salesforce CRM with complete contact information\n2. **HubSpot Contact Tool** - Create or update contacts in HubSpot CRM\n3. **Slack Notification Tool** - Send notifications to sales team channels\n4. **Web Search Tool** - Research companies, prospects, and market information\n\nFor each request, you must:\n1. Determine the appropriate action (create_lead, create_contact, send_notification, research)\n2. Identify the target platform (salesforce, hubspot, slack)\n3. Extract or gather all required information\n4. Use the appropriate tool to execute the action\n5. Provide structured output with action details, platform, data, confidence level, and reasoning\n\nAlways structure your response according to the output parser schema with fields: action, platform, leadData/contactData, confidence, and reasoning.\n\nIf information is missing, ask clarifying questions before proceeding.",
          "maxIterations": 15,
          "returnIntermediateSteps": true,
          "enableStreaming": true
        }
      }
    },
    {
      "id": "585b17d4-9cdb-4a61-ba9d-470ec80e4418",
