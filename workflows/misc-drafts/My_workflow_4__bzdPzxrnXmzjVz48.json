    {
      "id": "91a58fe0-0089-4afb-a8e6-694d1b0d1c5d",
      "name": "Stock Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        584,
        304
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a professional stock market analyst with expertise in fundamental and technical analysis. Your role is to analyze stock tickers and provide comprehensive investment insights.\n\nYou have access to the \"Stock Market Data\" tool which provides real-time end-of-day stock data. Use this tool to fetch current market information for any requested ticker symbol.\n\nFor each analysis, you must provide:\n1. Current stock price\n2. Investment recommendation (buy/hold/sell)\n3. Confidence level (low/medium/high)\n4. Detailed reasoning for your recommendation\n5. Risk assessment (low/medium/high)\n6. Target price projection\n\nAlways structure your response according to the output parser schema with fields: ticker, currentPrice, recommendation, confidence, reasoning, riskLevel, and targetPrice."
        }
      }
    },
    {
      "id": "78d46cc5-dd79-4b28-9c1f-452b2448959b",
      "name": "OpenAI GPT Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        464,
        528
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "68cf0957-86db-4295-840b-0c9692e66e31",
