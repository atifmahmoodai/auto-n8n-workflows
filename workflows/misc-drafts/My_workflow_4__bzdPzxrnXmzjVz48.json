      "typeVersion": 1,
      "position": [
        720,
        528
      ],
      "parameters": {
        "symbols": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('ticker', 'Stock ticker symbol (e.g., GOOGL, AAPL, MSFT)') }}",
        "limit": 30,
        "filters": {
          "latest": true
        }
      }
    },
    {
      "id": "f60e22b3-7c40-40a7-8502-b0075b01a192",
      "name": "Structured Analysis Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        848,
        528
      ],
      "parameters": {
        "jsonSchemaExample": "{ \"ticker\": \"AAPL\", \"currentPrice\": 150.25, \"recommendation\": \"buy\", \"confidence\": \"high\", \"reasoning\": \"Strong fundamentals and positive momentum\", \"riskLevel\": \"medium\", \"targetPrice\": 165.00 }"
      }
    },
    {
      "id": "ffe6bc26-8598-43d5-8cc8-dbc272142652",
      "name": "Extract Analysis Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1056,
        304
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "ticker",
              "value": "={{ $json.output.ticker }}",
              "type": "string"
            },
            {
              "id": "2",
