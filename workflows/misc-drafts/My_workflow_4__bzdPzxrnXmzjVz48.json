              "value": "={{ $json.output.currentPrice }}",
              "type": "number"
            },
            {
              "id": "3",
              "name": "recommendation",
              "value": "={{ $json.output.recommendation }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "confidence",
              "value": "={{ $json.output.confidence }}",
              "type": "string"
            },
            {
              "id": "5",
              "name": "reasoning",
              "value": "={{ $json.output.reasoning }}",
              "type": "string"
            },
            {
              "id": "6",
              "name": "riskLevel",
              "value": "={{ $json.output.riskLevel }}",
              "type": "string"
            },
            {
              "id": "7",
              "name": "targetPrice",
              "value": "={{ $json.output.targetPrice }}",
              "type": "number"
            },
            {
              "id": "8",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "9",
              "name": "sessionId",
              "value": "={{ $json.sessionId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "364aa2da-b8ab-427d-a9d2-01b11db89ea5",
      "name": "Analyze Sentiment",
      "type": "@n8n/n8n-nodes-langchain.sentimentAnalysis",
      "typeVersion": 1.1,
      "position": [
        1280,
        304
      ],
      "parameters": {
        "inputText": "={{ $json.reasoning }}",
        "options": {
          "categories": "Very Positive, Positive, Neutral, Negative, Very Negative",
          "includeDetailedResults": true
        }
      }
    },
    {
      "id": "a902c91b-f3b7-440d-a92b-f3678e4010d0",
      "name": "Sentiment Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1352,
        624
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "beaab45a-2acd-44e2-9775-d2e428192133",
      "name": "Route by Recommendation",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1632,
        272
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.recommendation }}",
                    "rightValue": "buy",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Strong Buy Signal"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.recommendation }}",
                    "rightValue": "hold",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Hold Position"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.recommendation }}",
                    "rightValue": "sell",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Sell Alert"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "3fcdc254-9369-4eeb-a9e1-22afc4b9e005",
      "name": "Save to Database",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1856,
        208
      ],
      "parameters": {
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "ticker",
              "keyValue": "={{ $json.ticker }}"
            },
            {
              "keyName": "timestamp",
              "keyValue": "={{ $json.timestamp }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ticker": "={{ $json.ticker }}",
            "currentPrice": "={{ $json.currentPrice }}",
            "recommendation": "={{ $json.recommendation }}",
            "confidence": "={{ $json.confidence }}",
            "reasoning": "={{ $json.reasoning }}",
            "riskLevel": "={{ $json.riskLevel }}",
            "targetPrice": "={{ $json.targetPrice }}",
            "sentiment": "={{ $json.sentiment }}",
            "sentimentScore": "={{ $json.sentimentScore }}",
            "timestamp": "={{ $json.timestamp }}",
            "sessionId": "={{ $json.sessionId }}"
          }
        },
        "options": {}
      }
    },
    {
      "id": "ef5e9aba-53fe-4590-bad0-41e072312235",
      "name": "Notify Slack - Buy Signal",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [
        2080,
        112
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "messageType": "block",
        "blocksUi": "=[\n  {\n    \"type\": \"header\",\n    \"text\": {\n      \"type\": \"plain_text\",\n      \"text\": \"🚀 Strong Buy Signal: {{ $json.ticker }}\"\n    }\n  },\n  {\n    \"type\": \"section\",\n    \"fields\": [\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*Current Price:*\\n${{ $json.currentPrice }}\"\n      },\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*Target Price:*\\n${{ $json.targetPrice }}\"\n      },\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*Confidence:*\\n{{ $json.confidence }}\"\n      },\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*Risk Level:*\\n{{ $json.riskLevel }}\"\n      }\n    ]\n  },\n  {\n    \"type\": \"section\",\n    \"text\": {\n      \"type\": \"mrkdwn\",\n      \"text\": \"*Analysis:*\\n{{ $json.reasoning }}\"\n    }\n  },\n  {\n    \"type\": \"section\",\n    \"text\": {\n      \"type\": \"mrkdwn\",\n      \"text\": \"*Sentiment:* {{ $json.sentiment }} (Score: {{ $json.sentimentScore }})\"\n    }\n  }\n]",
        "text": "=🚀 Strong Buy Signal for {{ $json.ticker }}",
        "otherOptions": {}
      },
      "webhookId": "7af81f7d-d38b-4da2-8744-1a14ea0716a5"
    },
    {
      "id": "7f6f7d93-8d99-4af5-8dce-1aab465d134d",
      "name": "Send Email Alert - Sell",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        2080,
        304
      ],
      "parameters": {
        "sendTo": "<__PLACEHOLDER_VALUE__your-email@example.com__>",
        "subject": "=⚠️ Sell Alert: {{ $json.ticker }} Stock Analysis",
        "message": "=<h2>⚠️ Sell Alert for {{ $json.ticker }}</h2>\n<p><strong>Current Price:</strong> ${{ $json.currentPrice }}</p>\n<p><strong>Recommendation:</strong> {{ $json.recommendation }}</p>\n<p><strong>Confidence:</strong> {{ $json.confidence }}</p>\n<p><strong>Risk Level:</strong> {{ $json.riskLevel }}</p>\n<p><strong>Target Price:</strong> ${{ $json.targetPrice }}</p>\n<hr>\n<p><strong>Analysis:</strong></p>\n<p>{{ $json.reasoning }}</p>\n<hr>\n<p><strong>Sentiment Analysis:</strong> {{ $json.sentiment }} (Score: {{ $json.sentimentScore }})</p>\n<p><em>Generated at {{ $json.timestamp }}</em></p>",
        "options": {
          "appendAttribution": false
        }
      },
      "webhookId": "7089823f-8012-4142-8589-9991b527f6c4"
    },
