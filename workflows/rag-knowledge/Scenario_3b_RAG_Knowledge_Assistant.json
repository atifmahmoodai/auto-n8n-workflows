{
  "name": "Scenario 3b: RAG Knowledge Assistant",
  "nodes": [
    {
      "id": "c0748b58-8b2b-4a6a-9943-945a423c2280",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        40
      ],
      "parameters": {
        "content": "SCENARIO 3b — RAG Query API\nPOST /knowledge-query { question, user_id? }\nUses Supabase vector store + Grok with citations."
      }
    },
    {
      "id": "df35435f-2349-4335-beca-0d7e56721886",
      "name": "Knowledge Query",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "knowledge-query",
        "responseMode": "responseNode"
      },
      "webhookId": "86fa6f3a-00e3-4512-8d41-618d1f199ea7"
    },
    {
      "id": "9f7781f6-b4b5-46f2-963b-191b671bef9e",
      "name": "Parse Question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first()?.json || {};\nconst body = j.body && typeof j.body === 'object' ? j.body : j;\nconst q = String(body.question || body.query || body.chatInput || '').trim();\nif (!q) return [{ json: { ok: false, error: 'question required' } }];\nreturn [{ json: { ok: true, question: q } }];"
      }
    },
    {
      "id": "9a8b7104-0ae0-43eb-a181-e64af2467c39",
      "name": "RAG Answer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        480,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.question }}",
        "options": {
          "systemMessage": "Answer using ONLY the knowledge base tool. Cite sources by document name. If unsure, say what is missing. Return clear markdown.",
          "maxIterations": 4
        },
        "enableStreaming": false
      }
    },
    {
      "id": "765d7d2f-2fac-4316-b355-ff0aa8a97746",
      "name": "Grok RAG Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatXAiGrok",
      "typeVersion": 1,
      "position": [
        464,
        432
      ],
      "parameters": {
        "model": "grok-2-1212",
        "options": {
          "temperature": 0.2
        }
      }
    },
    {
      "id": "d7c6212f-85d0-4e5d-bd03-7a762834642a",
      "name": "Knowledge Base Search",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        592,
        432
      ],
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search internal knowledge base for grounded answers with citations",
        "tableName": {
          "__rl": true,
          "mode": "id",
          "value": "knowledge_chunks"
        },
        "topK": 6
      }
    },
    {
      "id": "7280dc19-943c-4144-9688-57f0eb0d5013",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        592,
        640
      ],
      "parameters": {
        "model": "text-embedding-3-small"
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "694977e7-fc28-4267-a2e8-d7040ae5d1ca",
      "name": "Respond Answer",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        720,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, question: $(\"Parse Question\").item.json.question, answer: $json.output || $json.text || $json } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
