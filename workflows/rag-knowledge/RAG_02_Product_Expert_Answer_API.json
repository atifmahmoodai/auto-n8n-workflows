      }
    },
    {
      "id": "01a570c4-db80-4103-8c93-f8875eb24730",
      "name": "OpenAI Query Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        720,
        520
      ],
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {
          "dimensions": 1536
        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "aca8d4a6-1d0c-42c8-9ef9-5828287a9194",
      "name": "Build Retrieval Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const docs=$input.all().map((i,idx)=>{const j=i.json||{}; const m=j.metadata||j.document?.metadata||{}; const text=j.pageContent||j.content||j.text||j.document?.pageContent||JSON.stringify(j); return {rank:idx+1,content:text,metadata:m,score:j.score??j.similarity??j.distance??null};}); const q=$items('Normalize Question')[0].json.question; const sources=docs.map(d=>({sku:d.metadata.sku,product_name:d.metadata.product_name,price:d.metadata.price,score:d.score})); const contextText=docs.map(d=>`SOURCE ${d.rank} | SKU: ${d.metadata.sku||'n/a'} | Product: ${d.metadata.product_name||'n/a'} | Price: ${d.metadata.price||'n/a'}\\n${d.content}`).join('\\n\\n'); return [{json:{question:q,context:contextText,sources,match_count:docs.length}}];"
      }
    },
    {
      "id": "46b616ca-af76-40e8-ae8c-71d847de03d5",
      "name": "Generate Expert Answer",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4.1-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "type": "text",
              "content": "You are a product expert for this business. Answer only from retrieved product context. Do not invent prices, stock, warranty, compatibility, or SKUs. Return concise JSON with keys answer, confidence, follow_up_question."
            },
            {
              "role": "user",
              "type": "text",
              "content": "=Customer question:\n{{ $json.question }}\n\nRetrieved product context:\n{{ $json.context }}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.2,
          "maxTokens": 700,
          "textFormat": {
            "textOptions": {
              "type": "json_object",
              "verbosity": "medium"
            }
          }
        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "e43ccccf-9191-40e6-bc76-0bf454cd72b9",
      "name": "Format API Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const raw=$json.output_text||$json.text||$json.output||$json.message||JSON.stringify($json); let parsed; try{parsed=typeof raw==='string'?JSON.parse(raw):raw;}catch(e){parsed={answer:String(raw),confidence:'medium',follow_up_question:''};} const previous=$items('Build Retrieval Context')[0].json; return {answer:parsed.answer||'',confidence:parsed.confidence||'medium',follow_up_question:parsed.follow_up_question||'',sources:previous.sources,match_count:previous.match_count};"
      }
    },
    {
      "id": "349a5d02-cd8e-430b-8de7-bdc1c29437ca",
      "name": "Return JSON Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
