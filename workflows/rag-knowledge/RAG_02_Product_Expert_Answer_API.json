    {
      "id": "ae3cd146-468f-43de-9e02-5f217c28290d",
      "name": "Retrieve Product Matches",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "load",
        "tableName": {
          "__rl": true,
          "mode": "id",
          "value": "product_database"
        },
        "prompt": "={{ $json.question }}",
        "topK": 8,
        "includeDocumentMetadata": true,
        "options": {
          "queryName": "match_documents",
          "metadata": {
