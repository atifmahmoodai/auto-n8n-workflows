              "type": "string"
            },
            {
              "id": "id-5",
              "name": "Company Size",
              "value": "={{ $('Lead Submission Form').item.json.data['Company Size'] }}",
              "type": "string"
            },
            {
              "id": "id-6",
              "name": "Budget Range",
              "value": "={{ $('Lead Submission Form').item.json.data['Budget Range'] }}",
              "type": "string"
            },
            {
              "id": "id-7",
              "name": "Business Challenge",
              "value": "={{ $('Lead Submission Form').item.json.data['Business Challenge'] }}",
              "type": "string"
            },
            {
              "id": "id-8",
              "name": "Lead Score",
              "value": "={{ $json.output.score }}",
              "type": "number"
            },
            {
              "id": "id-9",
              "name": "Quality",
              "value": "={{ $json.output.quality }}",
              "type": "string"
            },
            {
              "id": "id-10",
              "name": "Reasoning",
              "value": "={{ $json.output.reasoning }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "2d82d130-0633-4594-aea4-9a460e13a0d7",
