{
  "name": "8- AI-Powered Lead Qualification and Notification System",
  "nodes": [
    {
      "id": "8514b7de-39c5-4243-9634-a16bed005ae4",
      "name": "Lead Submission Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        256,
        304
      ],
      "parameters": {
        "formTitle": "Lead Qualification Form",
        "formDescription": "Tell us about your business needs",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email Address",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Company Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Business Challenge",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Company Size",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "1-10"
                  },
                  {
                    "option": "11-50"
                  },
                  {
                    "option": "51-200"
                  },
                  {
                    "option": "201-1000"
                  },
                  {
                    "option": "1000+"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Budget Range",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Under $10k"
                  },
                  {
                    "option": "$10k-$50k"
                  },
                  {
                    "option": "$50k-$100k"
                  },
                  {
                    "option": "$100k-$500k"
                  },
                  {
                    "option": "$500k+"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false
        }
      },
      "webhookId": "557efc7e-065b-4c40-924c-2b7e2b6d3918"
    },
    {
      "id": "aceebc35-8a78-4d17-a9a1-a637ba55abe4",
      "name": "Score Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        480,
        304
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.formData }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a lead qualification expert. Analyze form submissions and score leads from 0-100 based on: company size (larger = higher score), budget range (higher budget = higher score), and business challenge complexity (specific, detailed challenges = higher score). Classify as: low (0-40), medium (41-70), high (71-100). Provide reasoning and create a personalized email message addressing their specific business challenge."
        }
      }
    },
    {
      "id": "15de32bf-234d-4006-bc5f-170d1c5511a8",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        488,
        528
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "52cb109a-4562-4b2b-ac8a-07c3bbb6babc",
      "name": "Lead Score Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        616,
        528
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n\t\"type\": \"object\",\n\t\"properties\": {\n\t\t\"score\": {\n\t\t\t\"type\": \"number\",\n\t\t\t\"description\": \"Lead score from 0-100\"\n\t\t},\n\t\t\"quality\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"enum\": [\"low\", \"medium\", \"high\"],\n\t\t\t\"description\": \"Lead quality tier\"\n\t\t},\n\t\t\"reasoning\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Brief explanation of the score\"\n\t\t},\n\t\t\"personalizedMessage\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Personalized email message for the lead\"\n\t\t}\n\t}\n}"
      }
    },
    {
      "id": "eaf54689-7f4e-4b46-b54e-4987e5d0ef97",
      "name": "Prepare Sheet Data",
      "type": "n8n-nodes-base.set",
