{
  "name": "Scenario 1: Lead Qualifier + Enrichment + Outreach",
  "nodes": [
    {
      "id": "2491eec6-9dca-4cc5-9889-bdd44b06b64f",
      "name": "Sticky Note 9ec20d9c",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        960,
        784
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "Setup",
            "position": [
              -220,
              60
            ],
            "parameters": {
              "width": 560,
              "height": 260,
              "content": "SCENARIO 1 — Lead Qualifier + Enrichment + Outreach\n\n1. Firecrawl API credential on scrape node\n2. Supabase `leads` table (extend with enrichment fields)\n3. After creation, set Execute Sub-workflow node to Scenario 5 Approval Hub workflow ID\n4. Gmail credential for outreach sender\n5. POST /production-lead-intake with { name, email, company, website, message }\n6. Approve via Scenario 5 webhook → triggers outreach executor"
            }
          }
        }
      }
    },
    {
      "id": "be57e9a9-5690-40e1-9d77-8a9275da1216",
      "name": "Lead Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "production-lead-intake",
        "responseMode": "responseNode"
      },
      "webhookId": "15879f1f-5fdf-4414-9c7b-e9fff4dad305"
    },
    {
      "id": "168a025b-3ad3-423b-a408-e0ee1fbce90d",
      "name": "Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function clean(v){return String(v??'').trim();}\nconst body = $input.first()?.json?.body || $input.first()?.json || {};\nconst email = clean(body.email).toLowerCase();\nconst website = clean(body.website || body.company_url || body.domain || '');\nconst domain = website ? website.replace(/^https?:///,'').split('/')[0] : (email.split('@')[1] || '');\nconst leadId = clean(body.lead_id) || ('lead_' + Date.now());\nif (!email.includes('@')) return [];\nconst siteUrl = website ? (website.startsWith('http') ? website : 'https://' + website) : (domain ? 'https://' + domain : '');\nreturn [{ json: {\n  lead_id: leadId,\n  name: clean(body.name),\n  email,\n  company: clean(body.company),\n  role: clean(body.role),\n  message: clean(body.message),\n  website: siteUrl,\n  domain,\n  source: clean(body.source || 'webhook'),\n  received_at: new Date().toISOString(),\n}}];"
      }
    },
    {
      "id": "ea5a9fc5-7c46-42ea-9f32-0e521a0d383b",
      "name": "Firecrawl Scrape Site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v1/scrape",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "firecrawlApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $('Validate Lead').item.json.website || ('https://' + $('Validate Lead').item.json.domain), formats: ['markdown'], onlyMainContent: true }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "4da833fb-9d9c-420c-969e-1ddeb5deba32",
      "name": "Prep Enrichment Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const lead = $('Validate Lead').item.json;\nconst md = $json.data?.markdown || $json.markdown || $json.data?.content || '';\nreturn { json: {\n  ...lead,\n  scrape_markdown: String(md).slice(0, 12000),\n  scrape_ok: Boolean(md),\n}};"
      }
    },
    {
      "id": "b1985ba7-9d7d-40d7-b2ee-26ebc9567d95",
      "name": "Grok Pain & Angle",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        960,
        180
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this lead for creative outreach angles. Lead: {{ JSON.stringify($('Prep Enrichment Context').item.json) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a B2B sales strategist. From the lead message and website markdown, identify pain points, buying signals, ICP fit narrative, and a creative outreach angle. Return structured JSON only.",
          "maxIterations": 2
        },
        "enableStreaming": false
      }
    },
    {
      "id": "92e380ad-c34f-4d63-80b8-8c6b535fa8d1",
      "name": "Grok Lead Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatXAiGrok",
      "typeVersion": 1,
      "position": [
        912,
        224
      ],
      "parameters": {
        "model": "grok-2-1212",
        "options": {
          "temperature": 0.4,
          "responseFormat": "json_object"
        }
      }
    },
    {
      "id": "6759f254-cdd8-4f1e-b438-2da6054492b8",
      "name": "Grok JSON Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
