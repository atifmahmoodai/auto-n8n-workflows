          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "112b4466-900b-4a5b-b89e-3b8bbf5492c5",
      "name": "Score JSON Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1040,
        736
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"fit_score\":82,\"tier\":\"hot\",\"icp_match\":true,\"key_pains\":[\"string\"],\"recommended_channel\":\"email\",\"compliance_note\":\"string\"}",
        "autoFix": true
      }
    },
    {
      "id": "55cebed5-c82c-48cd-b920-7031663ff5cc",
      "name": "Assemble Lead Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function parseAgent(item){ const o=item?.json?.output; if(typeof o==='object') return o; try{return JSON.parse(o||'{}')}catch(e){return {}} }\nconst lead = $('Prep Enrichment Context').first().json;\nconst grok = parseAgent($('Grok Pain & Angle').first());\nconst score = parseAgent($('OpenAI Structured Score').first());\nconst tier = score.tier || (score.fit_score>=75?'hot':score.fit_score>=50?'warm':'cold');\nreturn [{ json: {\n  ...lead,\n  fit_score: score.fit_score ?? null,\n  tier,\n  icp_match: score.icp_match ?? null,\n  key_pains: (score.key_pains||[]).join('; '),\n  pain_points: (grok.pain_points||[]).join('; '),\n  buying_signals: (grok.buying_signals||[]).join('; '),\n  outreach_angle: grok.outreach_angle || '',\n  creative_hook: grok.creative_hook || '',\n  recommended_channel: score.recommended_channel || 'email',\n  status: 'pending_approval',\n}}];"
      }
    },
    {
      "id": "3d6b0f22-12bf-4e59-b746-c09ec21df936",
      "name": "Generate Outreach Copy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Write personalized B2B outreach. Return JSON: email_subject, email_body, linkedin_message, call_script (30 sec). Be specific, not generic. Respect consent/compliance.' }, { role: 'user', content: JSON.stringify($json) } ] }) }}"
      }
    },
    {
      "id": "9250793b-2808-41f0-a46e-836b42e1d29e",
      "name": "Merge Outreach",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const lead = $('Assemble Lead Record').item.json;\nlet copy = {};\ntry { copy = JSON.parse($json.choices?.[0]?.message?.content || '{}'); } catch(e) {}\nreturn { json: { ...lead, email_subject: copy.email_subject||'', email_body: copy.email_body||'', linkedin_message: copy.linkedin_message||'', call_script: copy.call_script||'' } };"
      }
    },
