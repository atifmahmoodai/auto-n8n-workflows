      "name": "OpenAI Structured Score",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        960,
        420
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Score this lead 0-100 with structured JSON. Lead + enrichment: {{ JSON.stringify($('Prep Enrichment Context').item.json) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Strict B2B lead scorer. Return JSON with: fit_score (0-100), tier (hot|warm|cold), icp_match (boolean), key_pains (array), recommended_channel (email|linkedin|call), compliance_note (public data only).",
          "maxIterations": 2
        },
        "enableStreaming": false
      }
    },
    {
      "id": "615f7f12-809b-450a-80da-e6a81b3e3b42",
