        "jsonSchemaExample": "{\"pain_points\":[\"string\"],\"buying_signals\":[\"string\"],\"icp_fit\":\"string\",\"outreach_angle\":\"string\",\"creative_hook\":\"string\"}",
        "autoFix": true
      }
    },
