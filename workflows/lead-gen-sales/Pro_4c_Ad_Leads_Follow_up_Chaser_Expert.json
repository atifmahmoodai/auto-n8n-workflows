{
  "name": "Pro 4c | Ad Leads: Follow-up Chaser | Expert",
  "nodes": [
    {
      "id": "38e58fcf-e907-4dd1-be07-1c7ef8b5e2b5",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
