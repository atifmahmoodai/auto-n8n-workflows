    {
      "id": "b15ac75d-4f4d-49cf-aaf6-c13b0fdc70e2",
      "name": "Sticky Note 097d86e7",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "SMS Bot Architecture",
            "position": [
              -220,
              60
            ],
            "parameters": {
              "width": 500,
              "height": 240,
              "content": "HVAC SMS QUALIFICATION\n\n1. Twilio inbound SMS trigger\n2. Load lead state from sheet\n3. 3-step conversation (emergency -> address -> book)\n4. HubSpot contact + deal on qualified\n5. Slack alert on emergency leads\n\nA2P 10DLC registration required before production SMS volume."
            }
          }
        }
      }
    },
