    {
      "id": "a79d09e3-911c-4a77-a0eb-6db75547ed47",
      "name": "SMS Qualification State Machine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const inbound = $('Normalize SMS Payload').item.json;\nconst body = (inbound.message_body || '').trim();\nconst bodyUp = body.toUpperCase();\nconst phone = inbound.from_phone;\nconst calLink = 'REPLACE_WITH_HVAC_CAL_BOOKING_LINK';\nconst company = 'REPLACE_WITH_HVAC_COMPANY_NAME';\n\nconst rows = $('Sheet: Read All Leads').all().map((i) => i.json);\nlet lead = rows.find((r) => (r.caller_phone || '') === phone);\n\nif (!lead) {\n  lead = {\n    lead_id: 'HVAC-SMS-' + $now.toFormat('yyyyLLdd-HHmmss'),\n    created_at: $now.toISO(),\n    caller_phone: phone,\n    called_number: inbound.to_phone,\n    call_sid: '',\n    call_status: 'sms_inbound',\n    direction: 'inbound',\n    vertical: 'HVAC',\n    lead_source: 'sms_inbound',\n    qualify_step: 0,\n    pipeline_status: 'qualifying',\n    issue_type: 'unknown',\n    service_address: '',\n    preferred_time: '',\n    last_message: body,\n    sms_sent_at: '',\n    sms_reply_count: 0,\n    hubspot_contact_id: '',\n    hubspot_deal_id: '',\n    estimated_job_value: 800,\n    owner_notified: 'pending',\n    notes: 'Inbound SMS without prior missed call row',\n  };\n}\n\nlet step = Number(lead.qualify_step) || 0;\nlet reply = '';\nlet pipeline = lead.pipeline_status || 'qualifying';\nlet issue = lead.issue_type || 'unknown';\nlet address = lead.service_address || '';\nlet prefTime = lead.preferred_time || '';\nlet qualified = false;\nlet optedOut = false;\nlet isEmergency = false;\nlet replyCount = Number(lead.sms_reply_count) || 0;\nreplyCount += 1;\n\nif (bodyUp === 'STOP' || bodyUp === 'UNSUBSCRIBE' || bodyUp === 'CANCEL') {\n  optedOut = true;\n  pipeline = 'opted_out';\n  reply = company + ' HVAC: You are unsubscribed. Reply START to re-join.';\n} else if (bodyUp === 'START') {\n  pipeline = 'qualifying';\n  step = 0;\n  reply = 'Welcome back to ' + company + ' HVAC. AC/heat emergency? Reply YES or NO.';\n} else if (step === 0) {\n  if (bodyUp.includes('YES') || bodyUp === 'Y' || bodyUp.includes('EMERGENCY')) {\n    issue = 'emergency';\n    isEmergency = true;\n    step = 1;\n    reply = 'Got it - emergency noted. What is the service address? (street + city)';\n  } else if (bodyUp.includes('NO') || bodyUp === 'N') {\n    issue = 'routine';\n    step = 1;\n    reply = 'No problem. What service do you need and what is your address?';\n  } else {\n    reply = 'Please reply YES for AC/heat emergency or NO for routine service.';\n  }\n} else if (step === 1) {\n  if (body.length < 5) {\n    reply = 'Please send your full service address (street + city).';\n  } else {\n    address = body;\n    step = 2;\n    reply = 'Thanks! Book here: ' + calLink + ' — or reply BEST TIME and your preferred callback window.';\n  }\n} else if (step === 2) {\n  prefTime = body;\n  step = 3;\n  qualified = true;\n  pipeline = 'qualified';\n  reply = 'Perfect - we have your info. A tech will confirm shortly. For faster booking use: ' + calLink;\n} else {\n  reply = 'Thanks! Our team will follow up shortly. Book online: ' + calLink;\n}\n\nreturn {\n  json: {\n    ...lead,\n    qualify_step: step,\n    pipeline_status: pipeline,\n    issue_type: issue,\n    service_address: address,\n    preferred_time: prefTime,\n    last_message: body,\n    sms_reply_count: replyCount,\n    reply_sms: reply,\n    qualified,\n    opted_out: optedOut,\n    is_emergency: isEmergency,\n    hubspot_email: (phone.replace(/[^0-9]/g, '') + '@hvac-lead.local'),\n  },\n};"
      }
    },
