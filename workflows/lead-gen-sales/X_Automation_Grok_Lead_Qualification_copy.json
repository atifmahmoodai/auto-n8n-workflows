        "jsonBody": "={{ JSON.stringify({ query: $(\"Load Search Config\").first().json.keyword, numberOfTweets: 20, contentLanguage: \"en\", engagementMinLikes: $(\"Load Search Config\").first().json.minLikes, engagementMinReplies: $(\"Load Search Config\").first().json.minReplies, tweetTypes: [\"original\"], timeWithinTime: \"2d\" }) }}",
