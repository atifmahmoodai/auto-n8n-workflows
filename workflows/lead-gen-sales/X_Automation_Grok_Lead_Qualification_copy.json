        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/{{ $(\"Load Search Config\").first().json.apifyActor.replace(\"/\", \"~\") }}/run-sync-get-dataset-items?timeout=120",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
