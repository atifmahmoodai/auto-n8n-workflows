    {
      "id": "228dbe16-0f9f-4955-b35d-abd448f11c14",
      "name": "Normalize + Filter X Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        528
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Load Search Config').first().json;\nconst processed = new Set(($('Get Processed Tweet IDs').all() || []).map((item) => String(item.json.tweet_id || '').trim()).filter(Boolean));\nconst out = [];\nfunction pushTweet(tweet, source) {\n  const tweetId = String(tweet.tweet_id || tweet.id || tweet.tweetId || '').trim();\n  const text = String(tweet.text || tweet.full_text || tweet.tweetText || '').replace(/\\s+/g, ' ').trim();\n  if (!tweetId || processed.has(tweetId)) return;\n  const likes = Number(tweet.like_count || tweet.likeCount || tweet.public_metrics?.like_count || tweet.favorite_count || 0);\n  const replies = Number(tweet.reply_count || tweet.replyCount || tweet.public_metrics?.reply_count || 0);\n  const screen = tweet.screen_name || tweet.username || tweet.user?.username || tweet.author?.userName || tweet.author_id || 'unknown';\n  if (text.length < cfg.minTextLength || likes < cfg.minLikes || replies < cfg.minReplies) return;\n  if (!/need|looking for|help|struggling|problem|urgent|asap|recommend|hire|budget|automation|agent|workflow/i.test(text)) return;\n  out.push({ json: { tweet_id: tweetId, screen_name: screen, tweet_text: text, tweet_url: 'https://x.com/' + screen + '/status/' + tweetId, keyword_matched: cfg.keyword, likes, replies, followers_count: Number(tweet.followers_count || tweet.followersCount || 0), received_at: new Date().toISOString(), source, message: text, service_needed: cfg.keyword, raw_payload: JSON.stringify(tweet) } });\n}\nfor (const item of items) {\n  const body = item.json || {};\n  if (Array.isArray(body)) { for (const tweet of body) pushTweet(tweet, 'apify'); continue; }\n  if (body.data && Array.isArray(body.data)) { for (const tweet of body.data) pushTweet(tweet, 'apify'); continue; }\n  pushTweet(body, body.source || (cfg.useApify ? 'apify' : 'x_api'));\n}\nreturn out;"
      }
    },
