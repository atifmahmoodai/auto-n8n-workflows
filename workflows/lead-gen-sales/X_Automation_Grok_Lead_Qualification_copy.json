    {
      "id": "f7c5d1fe-420b-4b8c-ad27-95547845a759",
      "name": "Combine AI Score + Guardrails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        384
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "function clamp(v){return Math.max(0,Math.min(100,Math.round(Number(v)||0)));}\nfunction parse(raw){ if(raw?.output && typeof raw.output==='object') return raw.output; if(raw?.output && typeof raw.output==='string'){ try{return JSON.parse(raw.output)}catch(e){return {}} } return raw||{}; }\nfunction rule(lead){ let s=0; if(lead.tweet_text&&lead.tweet_text.length>60)s+=10; if(lead.likes>=10)s+=15; else if(lead.likes>=5)s+=10; else if(lead.likes>=3)s+=5; if(lead.replies>=3)s+=10; if(/urgent|asap|need|looking for|help|budget|hire|problem|struggling/i.test(lead.tweet_text||''))s+=20; if(/automation|n8n|workflow|agent|ai/i.test(lead.tweet_text||''))s+=15; return clamp(s); }\nfunction band(score){ if(score>=75)return 'HOT'; if(score>=50)return 'WARM'; if(score>=25)return 'COLD'; return 'MANUAL_REVIEW'; }\nconst lead = $('Normalize + Filter X Posts').item.json;\nconst ai = parse($json);\nconst deterministic = rule(lead);\nconst aiScore = Number.isFinite(Number(ai.ai_score ?? ai.score)) ? clamp(ai.ai_score ?? ai.score) : deterministic;\nconst finalScore = clamp(aiScore * 0.7 + deterministic * 0.3);\nlet status = ai.score_band && ['HOT','WARM','COLD','MANUAL_REVIEW'].includes(ai.score_band) ? ai.score_band : band(finalScore);\nif (ai.is_qualified_lead === false) status = 'COLD';\nconst route = status === 'HOT' ? 'sales_now' : status === 'WARM' ? 'sales_nurture' : status === 'COLD' ? 'marketing_nurture' : 'manual_review';\nreturn { json: { tweet_id: lead.tweet_id, status, ai_score: finalScore, route, fit_reason: ai.fit_reason || ('Rule score ' + deterministic + '; AI score ' + aiScore + '.'), next_action: ai.next_action || (status === 'HOT' ? 'Reply on X within 15 minutes.' : 'Queue for nurture follow-up.'), suggested_reply: ai.suggested_reply || '', model_used: 'grok-4.20-0309-reasoning', updated_at: new Date().toISOString() } };"
      }
    },
