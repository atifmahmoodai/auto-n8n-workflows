        "jsonSchemaExample": "{\"ai_score\":82,\"score_band\":\"HOT\",\"route\":\"sales_now\",\"fit_reason\":\"Clear pain and buying intent.\",\"next_action\":\"Reply within 15 minutes.\",\"suggested_reply\":\"Happy to share a quick automation setup for this.\",\"is_qualified_lead\":true}",
