    {
      "id": "a445d703-c762-462c-8572-5587cc53cfe8",
      "name": "Normalize + Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function pick(obj, keys, fallback = '') { for (const key of keys) { const value = obj?.[key]; if (value !== undefined && value !== null && String(value).trim() !== '') return value; } return fallback; }\nfunction clean(value) { return String(value ?? '').replace(/\\s+/g, ' ').trim(); }\nfunction email(value) { return clean(value).toLowerCase(); }\nfunction phone(value) { return clean(value).replace(/[^+0-9]/g, ''); }\nfunction money(value) { const parsed = Number(String(value ?? '').replace(/[^0-9.]/g, '')); return Number.isFinite(parsed) ? parsed : 0; }\nfunction days(value) { const text = clean(value).toLowerCase(); if (/today|asap|urgent|now/.test(text)) return 0; if (/tomorrow/.test(text)) return 1; if (/week/.test(text)) return 7; if (/month/.test(text)) return 30; const n = Number((text.match(/\\d+/) || [])[0]); return Number.isFinite(n) ? n : 999; }\nfunction shortHash(text) { let h = 0; for (let i = 0; i < text.length; i++) h = Math.imul(31, h) + text.charCodeAt(i) | 0; return Math.abs(h).toString(16); }\nreturn items.map((item, index) => { const p = item.json.body && typeof item.json.body === 'object' ? item.json.body : item.json; const name = clean(pick(p, ['name','full_name','fullName','contact_name'])); const em = email(pick(p, ['email','email_address','work_email'])); const ph = phone(pick(p, ['phone','phone_number','mobile','whatsapp'])); const company = clean(pick(p, ['company','company_name','business','organization'])); const source = clean(pick(p, ['source','utm_source','channel'], 'unknown')); const need = clean(pick(p, ['service_needed','service','need','project_type','interest'])); const budget = money(pick(p, ['budget_amount','budget','estimated_budget','price_range'])); const timelineText = clean(pick(p, ['timeline','urgency','start_date','needed_by'])); const timelineDays = days(timelineText); const message = clean(pick(p, ['message','notes','description','pain','problem'])); const base = `${em}|${ph}|${company}|${need}`.toLowerCase(); const fingerprint = shortHash(base || JSON.stringify(p)); const leadId = clean(pick(p, ['lead_id','id','submission_id'])) || `lead_${fingerprint}`; const errors = []; if (!em && !ph) errors.push('missing_contact'); if (!need && !message) errors.push('missing_need_or_message'); const linkCount = (JSON.stringify(p).match(/https?:\\/\\//g) || []).length; const spamScore = (!em && !ph ? 45 : 0) + (linkCount > 3 ? 25 : 0) + (message.length > 1500 ? 20 : 0); const validationStatus = spamScore >= 60 ? 'spam' : errors.length ? 'manual_review' : 'valid'; return { json: { lead_id: leadId, fingerprint, received_at: new Date().toISOString(), name, email: em, phone: ph, company, source, service_needed: need, budget_amount: budget, timeline_text: timelineText, timeline_days: timelineDays, message, spam_score: spamScore, validation_status: validationStatus, validation_errors: errors, raw_payload: JSON.stringify(p), item_index: index } }; });"
      }
    },
