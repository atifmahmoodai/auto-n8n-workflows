        "jsonSchemaExample": "{\"ai_score\":82,\"score_band\":\"HOT\",\"route\":\"sales_now\",\"priority\":\"high\",\"fit_reason\":\"Budget and urgency are clear.\",\"risk_flags\":[\"none\"],\"recommended_owner\":\"senior_sales\",\"next_action\":\"Call within 5 minutes.\",\"follow_up_message\":\"Thanks for reaching out. Our team will contact you shortly.\"}",
