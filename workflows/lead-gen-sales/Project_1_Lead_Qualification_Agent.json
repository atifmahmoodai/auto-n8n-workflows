    {
      "id": "65f598d5-c3ba-4a71-8c5b-f240bd868a1d",
      "name": "Combine AI Score + Guardrails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function clamp(v){return Math.max(0,Math.min(100,Math.round(Number(v)||0)));}\nfunction parse(raw){ if(raw?.output && typeof raw.output==='object') return raw.output; if(raw?.output && typeof raw.output==='string'){ try{return JSON.parse(raw.output)}catch(e){return {}} } return raw||{}; }\nfunction rule(lead){ let s=0; if(lead.email)s+=8; if(lead.phone)s+=10; if(lead.company)s+=7; if(lead.service_needed)s+=12; if(lead.message&&lead.message.length>30)s+=8; if(lead.budget_amount>=5000)s+=25; else if(lead.budget_amount>=2000)s+=18; else if(lead.budget_amount>=500)s+=10; if(lead.timeline_days<=2)s+=22; else if(lead.timeline_days<=7)s+=18; else if(lead.timeline_days<=30)s+=8; if(/urgent|asap|today|miss calls|losing leads|need this/i.test(`${lead.message} ${lead.timeline_text}`))s+=15; return clamp(s); }\nfunction band(score){ if(score>=75)return 'HOT'; if(score>=50)return 'WARM'; if(score>=25)return 'COLD'; return 'MANUAL_REVIEW'; }\nconst lead = $('Normalize + Validate Lead').first().json;\nreturn items.map(item=>{ const ai=parse(item.json); const deterministic=rule(lead); const aiScore=Number.isFinite(Number(ai.ai_score??ai.score))?clamp(ai.ai_score??ai.score):deterministic; let finalScore=clamp(aiScore*0.7+deterministic*0.3); let status=band(finalScore); const route=status==='HOT'?'sales_now':status==='WARM'?'sales_nurture':status==='COLD'?'marketing_nurture':'manual_review'; return { json:{ lead_id:lead.lead_id,status,ai_score:finalScore,route,fit_reason:ai.fit_reason||`Rule score ${deterministic}; AI score ${aiScore}.`,next_action:ai.next_action||(status==='HOT'?'Call within 5 minutes.':'Add to follow-up queue.'),model_used:'gpt-5-mini',updated_at:new Date().toISOString() } }; });"
      }
    },
