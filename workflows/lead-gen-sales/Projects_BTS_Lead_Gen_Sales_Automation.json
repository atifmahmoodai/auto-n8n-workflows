{
  "name": "Projects: BTS Lead Gen & Sales Automation",
  "nodes": [
    {
      "id": "fe62010a-fd2a-447f-b4a6-e16585446507",
      "name": "Sticky Note 14a8dc1d",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        528,
        688
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "BTS Lead Gen Architecture",
            "position": [
              -220,
              60
            ],
            "parameters": {
              "width": 540,
              "height": 260,
              "content": "BTS FINANCIAL LEAD GEN & SALES AUTOMATION\n\n1. Webhook POST /bts/new-lead\n2. AI qualifies lead (hot/warm/cold)\n3. Assigns to sales rep round-robin\n4. Logs to Google Sheets + sends Gmail outreach draft\n\nBased on projects.docx BTS Financial Group posting."
            }
          }
        }
      }
    },
    {
      "id": "bc28b879-225c-418f-974c-2dc0996e935f",
      "name": "Webhook: New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bts/new-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "c21460bb-5b4d-428f-8173-e6ee3aa445b5"
    },
    {
      "id": "ac4f59e8-be75-4524-8765-8783ff8e0d2d",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "name",
              "name": "lead_name",
              "value": "={{ $json.name || $json.body?.name || \"Unknown\" }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "lead_email",
              "value": "={{ $json.email || $json.body?.email || \"\" }}",
              "type": "string"
            },
            {
              "id": "company",
              "name": "company",
              "value": "={{ $json.company || $json.body?.company || \"\" }}",
              "type": "string"
            },
            {
              "id": "source",
              "name": "source",
              "value": "={{ $json.source || $json.body?.source || \"webhook\" }}",
              "type": "string"
            },
            {
              "id": "notes",
              "name": "notes",
              "value": "={{ $json.notes || $json.body?.notes || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "69e88dc5-9fbb-4ff1-abf4-b87a372c73c3",
      "name": "AI: Qualify Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Qualify this financial services lead for BTS Financial Group. Assign tier hot/warm/cold, score 0-100, draft outreach email, and pick sales rep (Rep A, Rep B, Rep C) via round-robin logic based on company name hash.\\n\\nLead: \" + JSON.stringify({ name: $json.lead_name, email: $json.lead_email, company: $json.company, source: $json.source, notes: $json.notes }) }}",
        "hasOutputParser": true
      }
    },
    {
      "id": "2692f135-a7c7-4b48-b71a-9fd9ab46807c",
      "name": "GPT-4o Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        528,
        640
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.3
        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "e2c27c74-cdcf-4129-a361-d1e5d7a7230c",
      "name": "Lead Qualification Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        560,
        432
      ],
      "parameters": {
        "schemaType": "fromJson",
        "autoFix": true,
        "jsonSchemaExample": {
          "score": 82,
          "tier": "hot",
          "reason": "High intent financial services lead with budget signals",
          "outreach_subject": "Quick intro - BTS Financial Group",
          "outreach_body": "Hi {{name}}, thanks for your interest...",
          "assigned_rep": "Rep A"
        }
      }
    },
    {
      "id": "db1758cb-5441-4512-bc93-748d050e4b2d",
      "name": "Merge Lead + Qualification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        760,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "ln",
              "name": "lead_name",
              "value": "={{ $(\"Normalize Lead\").item.json.lead_name }}",
              "type": "string"
            },
            {
              "id": "le",
              "name": "lead_email",
              "value": "={{ $(\"Normalize Lead\").item.json.lead_email }}",
              "type": "string"
            },
            {
              "id": "co",
              "name": "company",
              "value": "={{ $(\"Normalize Lead\").item.json.company }}",
              "type": "string"
            },
            {
              "id": "sc",
              "name": "score",
              "value": "={{ $json.output?.score || $json.score || 0 }}",
              "type": "number"
            },
            {
              "id": "ti",
              "name": "tier",
              "value": "={{ $json.output?.tier || $json.tier || \"cold\" }}",
              "type": "string"
            },
            {
              "id": "re",
              "name": "reason",
              "value": "={{ $json.output?.reason || $json.reason || \"\" }}",
              "type": "string"
            },
            {
              "id": "ar",
              "name": "assigned_rep",
              "value": "={{ $json.output?.assigned_rep || $json.assigned_rep || \"Rep A\" }}",
              "type": "string"
            },
            {
              "id": "os",
              "name": "outreach_subject",
              "value": "={{ $json.output?.outreach_subject || $json.outreach_subject || \"Introduction\" }}",
              "type": "string"
            },
            {
              "id": "ob",
              "name": "outreach_body",
              "value": "={{ $json.output?.outreach_body || $json.outreach_body || \"\" }}",
              "type": "string"
            },
            {
              "id": "ts",
              "name": "created_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "6e03047a-52f2-40b1-8551-5653a79ef14c",
      "name": "Log Lead to CRM Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "BTS_Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "created_at": "={{ $json.created_at }}",
            "lead_name": "={{ $json.lead_name }}",
            "lead_email": "={{ $json.lead_email }}",
            "company": "={{ $json.company }}",
            "score": "={{ $json.score }}",
            "tier": "={{ $json.tier }}",
            "assigned_rep": "={{ $json.assigned_rep }}",
            "reason": "={{ $json.reason }}",
            "status": "new"
          }
        },
        "options": {}
      }
    },
    {
      "id": "1e3db6e8-f1d1-4933-a069-ea61fb1980e0",
      "name": "Is Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1280,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.tier }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "hot"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "32d68c96-0f07-4e8d-8d57-5797520682dd",
      "name": "Gmail: Send Outreach",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1540,
        220
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.lead_email }}",
        "subject": "={{ $json.outreach_subject }}",
        "emailType": "text",
        "message": "={{ $json.outreach_body }}",
        "options": {}
      },
      "webhookId": "4f0a2c24-d101-4aac-8b04-657c24494be1"
    },
    {
      "id": "0b881dc3-d0aa-4d03-925f-d0fd39eefbe0",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1540,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, lead_name: $json.lead_name, tier: $json.tier, score: $json.score, assigned_rep: $json.assigned_rep, outreach_sent: $json.tier === \"hot\" } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
