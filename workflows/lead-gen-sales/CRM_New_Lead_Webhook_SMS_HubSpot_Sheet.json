            }
          ]
        }
      }
    },
    {
      "id": "7898bae2-f7af-42b9-94c6-c9a099d58a7b",
      "name": "Slack: New Lead Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.5,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SLACK_CHANNEL_ID"
        },
        "messageType": "text",
        "text": "={{ \":zap: NEW CRM LEAD\\n*Name:* \" + ($json.first_name || \"\") + \" \" + ($json.last_name || \"\") + \"\\n*Phone:* \" + $json.caller_phone + \"\\n*Email:* \" + ($json.email || \"n/a\") + \"\\n*Source:* \" + $json.lead_source + \"\\n*Instant SMS sent*\\n*Deal:* \" + ($json.hubspot_deal_id || \"pending\") + \"\\n*Lead ID:* \" + $json.lead_id }}",
        "otherOptions": {
