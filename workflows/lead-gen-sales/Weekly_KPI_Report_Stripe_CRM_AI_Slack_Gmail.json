    {
      "id": "2e68fe30-f683-43dc-99c1-1b5e12ecea86",
      "name": "Aggregate KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const balance = $('Stripe: Balance').first()?.json || {};\nconst txResp = $('Stripe: Last Week Transactions').first()?.json || {};\nconst crmRows = $('Sheet: Read CRM Metrics').all().map((i) => i.json);\nconst available = (balance.available || []).reduce((s,b)=>s+(Number(b.amount)||0),0)/100;\nconst transactions = Array.isArray(txResp.data)?txResp.data:[];\nconst grossVolume = transactions.reduce((s,t)=>s+Math.abs(Number(t.amount)||0),0)/100;\nconst latest = crmRows[crmRows.length-1]||{};\nconst prior = crmRows[crmRows.length-2]||{};\nconst num=v=>Number(v)||0;\nconst delta=(c,p)=>{c=num(c);p=num(p);return p?(((c-p)/p)*100).toFixed(1)+'%':'0%'};\nconst kpis={report_week_ending:$now.toFormat('yyyy-MM-dd'),stripe_available_usd:available,stripe_gross_volume_usd:grossVolume,new_leads:num(latest.new_leads),deals_closed:num(latest.deals_closed),pipeline_value_usd:num(latest.pipeline_value_usd),leads_delta:delta(latest.new_leads,prior.new_leads),deals_delta:delta(latest.deals_closed,prior.deals_closed)};\nconst summary=['Week ending: '+kpis.report_week_ending,'Stripe available: $'+kpis.stripe_available_usd,'Gross volume (7d): $'+kpis.stripe_gross_volume_usd,'New leads: '+kpis.new_leads+' ('+kpis.leads_delta+')','Deals closed: '+kpis.deals_closed+' ('+kpis.deals_delta+')'].join('\\n');\nreturn [{json:{...kpis,kpi_summary:summary,ai_prompt:'Analyze weekly KPIs and explain what changed.\\n'+JSON.stringify(kpis,null,2)}}];"
      }
    },
    {
      "id": "631f37bd-271c-4aaa-8fba-9bbb5f69ba52",
