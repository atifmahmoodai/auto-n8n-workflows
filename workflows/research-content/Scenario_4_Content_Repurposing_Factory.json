            },
            {
              "fieldId": "format",
              "fieldValue": "={{ $(\"Merge Content Assets\").item.json.format }}"
            },
            {
              "fieldId": "content_json",
              "fieldValue": "={{ $(\"Merge Content Assets\").item.json.content_json }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "pending_approval"
            },
            {
              "fieldId": "created_at",
              "fieldValue": "={{ $(\"Merge Content Assets\").item.json.created_at }}"
            }
          ]
        }
      }
    },
    {
      "id": "7bc393a7-f117-471c-87ba-bc8c3a4b2068",
      "name": "Call Approval Hub",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
