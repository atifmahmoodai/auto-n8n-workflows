{
  "name": "Product Finder and Price Checker",
  "nodes": [
    {
      "id": "6f3c4301-583b-4c44-8807-564c0c61c5c3",
      "name": "Product Search Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        240,
        496
      ],
      "parameters": {
        "formTitle": "Product Finder & Price Checker",
        "formDescription": "Enter your product search criteria to find the best deals",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Product Name",
              "fieldName": "productName",
              "placeholder": "e.g. iPhone 15 Pro",
              "requiredField": true
            },
            {
              "fieldLabel": "Product Category",
              "fieldName": "productCategory",
              "placeholder": "e.g. Electronics, Clothing"
            },
            {
              "fieldLabel": "Price Range",
              "fieldName": "priceRange",
              "placeholder": "e.g. $100-$500"
            },
            {
              "fieldLabel": "Country",
              "fieldName": "country",
              "placeholder": "e.g. United States",
              "requiredField": true
            },
            {
              "fieldLabel": "City",
              "fieldName": "city",
              "placeholder": "e.g. New York (optional)"
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "fieldName": "email",
              "placeholder": "your@email.com",
              "requiredField": true
            },
            {
              "fieldLabel": "Check Availability",
              "fieldType": "checkbox",
              "fieldName": "checkAvailability",
              "fieldOptions": {
                "values": [
                  {}
                ]
              }
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thank you! We are searching for your product. You will receive results via email and Pushover notification."
            }
          }
        }
      },
      "webhookId": "6f4a7b6e-dc13-4d4a-94ba-14e77462550e"
    },
    {
      "id": "a510ede3-9766-4194-a4ac-79d11cb164f6",
      "name": "Send Pushover Notification",
      "type": "n8n-nodes-base.pushover",
      "typeVersion": 1,
      "position": [
        1376,
        304
      ],
      "parameters": {
        "userKey": "uzfmrnrdxm1mygsf8o65iu5qj8vgs3",
        "message": "=🛍️ Product Search Results\\n\\nQuery: {{ $json.searchQuery }}\\nCategory: {{ $json.category }}\\nPrice Range: {{ $json.priceRange }}\\nLocation: {{ $json.location }}\\n\\n{{ $json.searchSummary }}\\n\\n{{ $json.products.map((p, i) => `${i + 1}. ${p.name}\\n   💰 ${p.price} ${p.currency}\\n   🏪 ${p.store}\\n   ${p.availability.toLowerCase().includes(\"stock\") || p.availability.toLowerCase().includes(\"available\") ? \"✅\" : \"⚠️\"} ${p.availability}\\n   🔗 ${p.url}`).join(\"\\n\\n\") }}",
        "priority": 0,
        "additionalFields": {
          "url": "={{ $json.firstProductUrl }}",
          "url_title": "View Product"
        }
      }
    },
    {
      "id": "a70d0ee3-886b-496c-8a28-45a852377510",
      "name": "Send Email Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1376,
        496
      ],
      "parameters": {
        "sendTo": "=atifmah428@gmail.com",
        "subject": "=🛍️ Product Search Results: {{ $json.searchQuery }} ({{ $json.productCount }} products found)",
        "message": "=<h2>🛍️ Product Search Results</h2><p>Here are the results for your product search:</p><ul><li><strong>Search Query:</strong> {{ $json.searchQuery }}</li><li><strong>Category:</strong> {{ $json.category }}</li><li><strong>Price Range:</strong> {{ $json.priceRange }}</li><li><strong>Location:</strong> {{ $json.location }}</li></ul><h3>{{ $json.searchSummary }}</h3>{{ $json.products.map((p, i) => `<div style=\"margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 8px;\"><h4>${i + 1}. ${p.name}</h4><p><strong>Price:</strong> ${p.price} ${p.currency}<br><strong>Store:</strong> ${p.store}<br><strong>Availability:</strong> ${p.availability.toLowerCase().includes(\"stock\") || p.availability.toLowerCase().includes(\"available\") ? \"✅\" : \"⚠️\"} ${p.availability}<br><a href=\"${p.url}\" style=\"color: #0066cc; text-decoration: none;\">View Product →</a></p></div>`).join(\"\") }}<p style=\"margin-top: 30px; color: #666;\">Happy shopping! 🎉</p>",
        "options": {}
      },
      "webhookId": "b772ccd1-fe26-4200-a6b7-6fc97702eeaa"
    },
    {
      "id": "84564ef8-14e1-49f4-9d6e-aad30c9860eb",
      "name": "Search Product Online",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        520,
        496
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Find products matching these criteria:\nProduct: {{ $json.productName }}\nCategory: {{ $json.productCategory }}\nPrice Range: {{ $json.priceRange }}\nLocation: {{ $json.city ? $json.city + \", \" + $json.country : $json.country }}\n{{ $json.checkAvailability ? \"Check availability status\" : \"\" }}\n\nSearch online and return 1-3 real products with actual prices, store names, purchase links, and availability status. Be specific and include exact URLs.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a product search assistant. Use the Google Search tool to find real products online. Return results with product names, prices, URLs, stores, and availability status.",
          "maxIterations": 20
        }
      }
    },
    {
      "id": "e9f86bb2-4a32-454d-be02-45b671644d54",
