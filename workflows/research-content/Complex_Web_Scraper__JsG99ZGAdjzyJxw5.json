    {
      "id": "c2aedabd-6f9f-468d-9c11-be9f0a94e641",
      "name": "Generate URL List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        616
      ],
      "parameters": {
        "jsCode": "// Generate URLs to scrape\nconst baseUrl = 'https://example.com/page/';\nconst startPage = 1;\nconst endPage = 50;\n\nconst urls = [];\nfor (let i = startPage; i <= endPage; i++) {\n  urls.push({\n    url: baseUrl + i,\n    pageNumber: i\n  });\n}\n\nreturn urls;"
      }
    },
    {
      "id": "8c52f54d-0b6c-4c65-928d-b64614fb86b3",
      "name": "Generate Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        208
      ],
      "parameters": {
        "jsCode": "// Generate summary statistics\nconst items = $input.all();\n\nconst summary = {\n  totalProcessed: items.length,\n  successful: items.filter(i => i.json.status === 'success').length,\n  duplicates: items.filter(i => i.json.status === 'duplicate').length,\n  failed: items.filter(i => i.json.status === 'failed').length,\n  completedAt: new Date().toISOString()\n};\n\nreturn [summary];"
      }
    },
    {
      "id": "66bd2fe2-95ff-4351-860d-74e7c64c2972",
      "name": "Rate Limit Delay",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        912,
        400
      ],
      "parameters": {
        "amount": 2
      },
      "webhookId": "1ec18d0e-dcd3-4b88-b1d3-e05b2de3ab92"
    },
    {
      "id": "5401af04-ee72-4470-a41e-c5ffb33f8c8d",
      "name": "Fetch Page HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1136,
        400
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "redirect": {
            "redirect": {
              "maxRedirects": 5
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "9d206407-0070-49aa-b0ad-7ddef1bef036",
      "name": "Extract Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        400
      ],
      "parameters": {
        "jsCode": "// Extract data from HTML\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const html = item.json.data;\n  \n  // Simple regex-based extraction (in production, use a proper HTML parser)\n  const titleMatch = html.match(/<h1[^>]*>(.*?)<\\/h1>/i);\n  const contentMatch = html.match(/<div class=\"content\"[^>]*>(.*?)<\\/div>/i);\n  \n  results.push({\n    url: item.json.url,\n    pageNumber: item.json.pageNumber,\n    title: titleMatch ? titleMatch[1].trim() : '',\n    content: contentMatch ? contentMatch[1].trim() : '',\n    scrapedAt: new Date().toISOString()\n  });\n}\n\nreturn results;"
      }
    },
    {
      "id": "9385578d-e726-4343-9d17-de57c6aac95c",
      "name": "Filter Valid Data",
      "type": "n8n-nodes-base.filter",
