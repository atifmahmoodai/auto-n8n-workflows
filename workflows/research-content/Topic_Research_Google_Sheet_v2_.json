{
  "name": "Topic Research → Google Sheet (v2)",
  "nodes": [
    {
      "id": "a23a4f3a-9a3c-43d0-9c5f-3707bd429317",
      "name": "Research request",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Topic Research",
        "formDescription": "Enter a topic and how many sources to pull. I will search the web, scrape each source, summarize them, save the findings to your Google Sheet, and write a combined briefing.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Topic",
              "fieldType": "text",
              "placeholder": "e.g. best open-source AI agent frameworks 2026",
              "requiredField": true
            },
            {
              "fieldLabel": "Sources",
              "fieldType": "dropdown",
              "requiredField": true,
              "defaultValue": "5",
              "fieldOptions": {
                "values": [
                  {
                    "option": "3"
                  },
                  {
                    "option": "5"
                  },
                  {
                    "option": "10"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "buttonLabel": "Research",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Got it - researching now. Findings and a briefing will appear in your Google Sheet shortly."
            }
          }
        }
      },
      "webhookId": "a11c73f9-9917-4748-856d-d449eed55dcd"
    },
    {
      "id": "66e542e7-09c5-4689-9718-fa21e54e66e8",
      "name": "Firecrawl search and scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v1/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "firecrawlApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"query\": $json.Topic, \"limit\": (Number($json.Sources) || 5), \"scrapeOptions\": { \"formats\": [\"markdown\"], \"onlyMainContent\": true } } }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "3589c4a9-f67e-409b-9d9d-894f484f7607",
      "name": "Normalize results",
