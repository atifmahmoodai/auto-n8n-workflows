      "typeVersion": 1.2,
      "position": [
        1080,
        -120
      ],
      "parameters": {
        "text": "={{ ($json.markdown || $json.description || \"\").slice(0, 8000) }}",
        "schemaType": "fromAttributes",
        "attributes": {
          "attributes": [
            {
              "name": "summary",
              "type": "string",
              "description": "A factual 2-3 sentence summary of what this page says about the research topic. If the page content is empty or unrelated to the topic, return exactly: No relevant content found.",
              "required": true
            },
            {
              "name": "key_points",
              "type": "string",
              "description": "The 3-5 most important facts or takeaways from this page, as one string with each point separated by a semicolon. Empty string if none.",
              "required": false
            }
          ]
        },
        "options": {}
      }
    },
