              "id": "res-array",
              "name": "results",
              "value": "={{ $json.data ?? $json.results ?? [] }}",
              "type": "array"
            }
          ]
        }
      }
    },
    {
      "id": "549c3bb2-7541-4b52-9e27-8d2868818610",
      "name": "Any results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        640,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.results }}",
              "operator": {
                "type": "array",
                "operation": "notEmpty"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
