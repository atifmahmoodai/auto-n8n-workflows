    {
      "id": "05292519-dd67-43f5-a194-398363a75a2f",
      "name": "Normalize Top Search Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().flatMap(i => i.json.data || i.json.results || []); return rows.slice(0,5).map((r,idx)=>({json:{url:r.url,title:r.title,rank:idx+1}}));"
      }
    },
    {
      "id": "76854daa-4acb-438b-8fe0-cd1486cca84e",
      "name": "Format Final Chat Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const data = $input.first().json.output || $input.first().json;\nconst ranked = Array.isArray(data.ranked_sources) ? data.ranked_sources : [];\nconst sourceLines = ranked.map(s => (s.rank + '. ' + (s.title || 'Untitled') + ' — ' + (s.url || '') + '\\n   Score: ' + (s.score ?? 'n/a') + ' | Why: ' + (s.why_ranked || '') + '\\n   Summary: ' + (s.summary || ''))).join('\\n');\nconst output = '# Final Answer\\n\\n' + (data.final_answer || 'No final answer generated.') + '\\n\\n## Ranked Sources\\n' + (sourceLines || 'No ranked sources returned.') + '\\n\\n## Limitations\\n' + (data.limitations || 'Not specified.');\nreturn [{ json: { output } }];"
      }
    },
    {
      "id": "27f79a0c-8d46-4497-8431-35f24dfd244e",
      "name": "Scrape Page Content",
      "type": "@mendable/n8n-nodes-firecrawl.firecrawl",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "resource": "Scraping",
        "operation": "scrape",
        "url": "={{ $json.url }}",
        "requestOptions": {}
      },
      "credentials": {
        "firecrawlApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "b2890d27-b9ff-403d-9356-c969b9858f8e",
      "name": "Scrape Pages One By One",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        900,
        0
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "56d72575-af81-415a-b9e9-99ff8aea089c",
      "name": "Build Source Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1450,
        220
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const original = $('Normalize Top Search Results').all()[$itemIndex]?.json || {};\nconst page = $json.data || $json;\nconst meta = page.metadata || {};\nconst rawText = page.markdown || page.content || page.text || page.html || '';\nreturn {\n  json: {\n    question: $('Ask Research Question').first().json.chatInput || '',\n    sourceRankFromSearch: original.rank || ($itemIndex + 1),\n    title: meta.title || page.title || original.title || '',\n    url: meta.sourceURL || meta.url || page.url || original.url || '',\n    excerpt: String(rawText).replace(/\\s+/g, ' ').trim().slice(0, 6000)\n  }\n};"
      }
    },
    {
      "id": "70af48bf-b943-47fe-a5e2-fa4c0c270226",
      "name": "Writer OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
