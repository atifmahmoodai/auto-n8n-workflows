      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"final_answer\":\"Clear final answer based only on the scraped sources.\",\"ranked_sources\":[{\"rank\":1,\"title\":\"Source title\",\"url\":\"https://example.com\",\"score\":90,\"why_ranked\":\"Why this source is useful.\",\"summary\":\"Short source summary.\"}],\"limitations\":\"What could not be verified.\"}"
      }
    },
    {
      "id": "fc432ce8-d04f-4262-bdd3-e9c4ad76b515",
      "name": "Summarize Rank And Write Final Answer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ 'User question: ' + $('Ask Research Question').first().json.chatInput + '\\n\\nScraped source briefs JSON:\\n' + JSON.stringify($input.all().map(i => i.json)) + '\\n\\nTask: summarize each useful source, rank the sources by relevance/authority/specificity/freshness, then write a final answer. Use only the provided source briefs. Do not invent facts. Include source URLs in ranked_sources.' }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a research analyst. Use only the provided scraped source briefs. Rank sources, summarize them, and write a direct final answer with source URLs. Return only the structured JSON required by the parser.",
          "maxIterations": 4,
          "enableStreaming": false
        }
      }
    }
