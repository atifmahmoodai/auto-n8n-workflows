        }
      }
    },
    {
      "id": "67872e6a-57f4-41f0-b0a4-55c54684257b",
      "name": "Final Answer JSON Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1980,
