      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-summary",
              "leftValue": "={{ $json.Summary }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              },
              "rightValue": ""
            },
            {
              "id": "is-relevant-str",
              "leftValue": "={{ $json.Summary }}",
              "operator": {
                "type": "string",
                "operation": "notContains"
              },
              "rightValue": "No relevant content"
            },
            {
              "id": "is-relevant-bool",
              "leftValue": "={{ $('Summarize source').item.json.is_relevant }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
