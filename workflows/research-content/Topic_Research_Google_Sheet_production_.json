{
  "name": "Topic Research → Google Sheet (production)",
  "nodes": [
    {
      "id": "5b358d78-6d4a-4114-abbd-cc089b293106",
      "name": "Research request",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "parameters": {
        "authentication": "n8nUserAuth",
        "formTitle": "Topic Research",
        "formDescription": "Enter a topic and how many sources to pull. I will search the web, scrape each source, summarize them, save the findings to your Google Sheet, and write a combined briefing.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Topic",
              "fieldType": "text",
              "placeholder": "e.g. best open-source AI agent frameworks 2026",
              "requiredField": true
            },
            {
              "fieldLabel": "Sources",
              "fieldType": "dropdown",
              "requiredField": true,
              "defaultValue": "5",
              "fieldOptions": {
                "values": [
                  {
                    "option": "3"
                  },
                  {
                    "option": "5"
                  },
                  {
                    "option": "10"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "buttonLabel": "Research",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Got it - researching now. Findings and a briefing will appear in your Google Sheet shortly."
            }
          }
        }
      },
      "webhookId": "2ea3380e-6c3b-4302-91b7-1e6fc6382841"
    },
    {
      "id": "05b5ed53-e2c7-4b25-a834-b7e87a71b017",
      "name": "Firecrawl search and scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v1/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "firecrawlApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"query\": $json.Topic, \"limit\": (Number($json.Sources) || 5), \"scrapeOptions\": { \"formats\": [\"markdown\"], \"onlyMainContent\": true } } }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "1881821d-8d56-4ba4-aa45-ccc3ee4e3ab6",
      "name": "Normalize results",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "res-array",
              "name": "results",
              "value": "={{ $json.data ?? $json.results ?? [] }}",
              "type": "array"
            }
          ]
        }
      }
    },
    {
      "id": "da2490b4-bb04-435c-87f5-c28c1187c905",
      "name": "Any results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        640,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.results }}",
              "operator": {
                "type": "array",
                "operation": "notEmpty"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "47537174-b4a7-4237-9338-c6cf511f7d7e",
      "name": "Split sources",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        860,
        -140
      ],
      "parameters": {
        "fieldToSplitOut": "results",
        "include": "noOtherFields"
      }
    },
    {
      "id": "5317d5e7-f0db-4701-bcbc-c2dce1d68b1f",
      "name": "Summarize source",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1080,
        -140
      ],
      "parameters": {
        "text": "={{ ($json.markdown || $json.description || \"\").slice(0, 8000) }}",
        "schemaType": "fromAttributes",
        "attributes": {
          "attributes": [
            {
              "name": "summary",
              "type": "string",
              "description": "A factual 2-3 sentence summary of what this page says about the research topic. If the page content is empty or unrelated to the topic, return exactly: No relevant content found.",
              "required": true
            },
            {
              "name": "key_points",
              "type": "string",
              "description": "The 3-5 most important facts or takeaways from this page, as one string with each point separated by a semicolon. Empty string if none.",
              "required": false
            },
            {
              "name": "is_relevant",
              "type": "boolean",
              "description": "true ONLY if this page contains real, on-topic content that helps answer the research topic. Set false if the page is empty, an error or 404 page, a paywall or login wall, a cookie/consent notice, a navigation or link-list page, or is unrelated to the topic.",
              "required": true
            }
          ]
        },
        "options": {
          "batching": {
            "batchSize": 5,
            "delayBetweenBatches": 800
          }
        }
      }
    },
