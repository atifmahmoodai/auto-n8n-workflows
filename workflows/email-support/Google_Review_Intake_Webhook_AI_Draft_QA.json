        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "1cf4d7dd-610c-49f6-be9e-dbdb369d4ed3",
      "name": "Review Response Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        560,
        432
      ],
      "parameters": {
        "schemaType": "fromJson",
        "autoFix": true,
        "jsonSchemaExample": {
          "draft_response": "Thank you for your kind words, Sarah!",
          "tone": "warm_professional",
          "needs_escalation": false,
          "escalation_reason": ""
        }
      }
    },
    {
      "id": "91004d15-e8ab-4830-909c-f08c5bb7f6bf",
      "name": "Build Review QA Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const src = $('Normalize Review Payload').item.json;\nconst out = $input.item.json.output || $input.item.json;\nconst reviewId = 'REV-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();\nreturn { json: { review_id: reviewId, received_at: $now.toISO(), rating: src.rating, review_text: src.review_text, author: src.author, location: src.location, draft_response: out.draft_response || '', tone: out.tone || 'warm_professional', needs_escalation: Boolean(out.needs_escalation), escalation_reason: out.escalation_reason || '', status: 'pending_approval', approved_by: '', approved_at: '', posted_at: '', posted_by: '' } };"
      }
    },
