{
  "name": "Google Review Intake: Webhook -> AI Draft -> QA",
  "nodes": [
    {
      "id": "1b285218-6249-4e89-9722-99cba62b6fbd",
      "name": "Sticky Note 19563665",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        528,
        688
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "Review Intake Architecture",
            "position": [
              -220,
              60
            ],
            "parameters": {
              "width": 520,
              "height": 260,
              "content": "GOOGLE REVIEW RESPONSE (HUMAN POST)\n\n1. Webhook POST /reviews/new (rating, text, author, location)\n2. AI drafts on-brand response\n3. Append Review_QA sheet status=pending_approval\n4. Slack posts draft for owner approval\n\nNo GBP API - owner pastes approved reply manually."
            }
          }
        }
      }
    },
    {
      "id": "4e51eafe-0c9e-4af7-9a8e-f6009ecc5495",
      "name": "Webhook: New Review",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "reviews/new",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "e7bb1179-3089-4d93-a5dd-9529ae3bfa4f"
    },
    {
      "id": "3b468326-20a1-40c5-8d92-8df497fcab48",
      "name": "Normalize Review Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "rating",
              "name": "rating",
              "value": "={{ Number($json.rating || $json.body?.rating || 0) }}",
              "type": "number"
            },
            {
              "id": "review-text",
              "name": "review_text",
              "value": "={{ $json.text || $json.review_text || $json.body?.text || \"\" }}",
              "type": "string"
            },
            {
              "id": "author",
              "name": "author",
              "value": "={{ $json.author || $json.reviewer || $json.body?.author || \"Anonymous\" }}",
              "type": "string"
            },
            {
              "id": "location",
              "name": "location",
              "value": "={{ $json.location || $json.body?.location || \"Main Location\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "78ccd306-0836-46ad-83e5-52cce62cf254",
      "name": "AI: Draft Review Response",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        480,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Brand: REPLACE_WITH_BRAND_NAME\\nLocation: \" + $json.location + \"\\nReviewer: \" + $json.author + \"\\nRating: \" + $json.rating + \"/5\\nReview: \" + $json.review_text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You write on-brand Google Business Profile review responses. Be concise and HIPAA-safe.",
          "maxIterations": 2
        }
      }
    },
    {
      "id": "441ecff3-2ff4-4a5a-841f-6ef453ebd121",
      "name": "GPT-5 Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        528,
        640
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
