    {
      "id": "112fbbe9-469d-43a6-bd3c-7505cde63e8a",
      "name": "Classify Email",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -896,
        80
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Email Subject: {{ $json.Subject }}\n\nEmail Body:\n{{ $json.snippet }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are an email classification assistant. Your task is to analyze incoming emails and determine whether they are sponsorship requests.\n\nA sponsorship request typically:\n- Asks for paid promotion or advertising\n- Offers to pay for content featuring their product/service\n- Requests collaboration in exchange for payment\n- Mentions brand partnerships or sponsored content\n- Has the word sponsor or sponsorship in it\n\nAnalyze the email subject and body, then return your classification."
        }
      }
    },
    {
      "id": "98b53620-9eeb-41e7-b026-04f8df530962",
      "name": "Classification Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -736,
        304
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n\t\"type\": \"object\",\n\t\"properties\": {\n\t\t\"isSponsorship\": {\n\t\t\t\"type\": \"boolean\",\n\t\t\t\"description\": \"True if the email is a sponsorship request, false otherwise\"\n\t\t}\n\t}\n}"
      }
    },
    {
      "id": "1f7e41a4-73dd-4bf8-a9e8-c3880c86194b",
      "name": "Is Sponsorship Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -544,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "id-1",
              "leftValue": "={{ $json.output.isSponsorship }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "18c934a3-66f7-47a4-bfd5-d996dba0337f",
      "name": "Add Important Label",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        -224,
