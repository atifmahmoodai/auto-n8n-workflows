    {
      "id": "54e4edab-1708-4e9b-b938-d47316d4ff51",
      "name": "Generate Sponsorship Reply",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -320,
        224
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Email Subject: {{ $json.subject }}\n\nSender: {{ $json.from }}",
        "options": {
          "systemMessage": "You are a professional email assistant. Your task is to craft a polite and professional reply to sponsorship requests.\n\nThe reply should:\n1. Thank the sender for reaching out\n2. Politely explain that you do not accept sponsorships at this time\n3. Be brief, courteous, and professional\n4. Maintain a friendly tone\n\nGenerate only the email body text, without subject line or signature."
        }
      }
    },
    {
      "id": "fdb53c6b-3c29-4039-a1d8-23f4ab0d3630",
      "name": "Save Reply as Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        32,
        224
      ],
      "parameters": {
        "resource": "draft",
        "subject": "=Re: {{ $('When Email Arrives').item.json.Subject }}",
        "message": "={{ $json.output }}",
        "options": {
          "replyTo": "={{ $('When Email Arrives').item.json.From }}",
          "threadId": "={{ $('When Email Arrives').item.json.threadId }}",
          "sendTo": "={{ $('When Email Arrives').item.json.From }}"
        }
      },
      "webhookId": "73fcd8c3-5afa-4d79-bc15-b270f9129e60"
    },
