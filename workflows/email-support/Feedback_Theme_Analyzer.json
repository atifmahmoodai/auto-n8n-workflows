        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ topic: 'feedback-CHANGEME', title: 'Feedback analysis', message: $json.summary }) }}"
      }
    },
