{
  "name": "Staffing Timesheet Ingest: Email -> AI Extract -> Sheet",
  "nodes": [
    {
      "id": "a6ae7e05-6be4-4e0f-bc60-c66142627bcd",
      "name": "Sticky Note f78a4c95",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1872,
        688
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "Ingest Architecture",
            "position": [
              -200,
              80
            ],
            "parameters": {
              "width": 520,
              "height": 260,
              "content": "STAFFING TIMESHEET INGEST\n\n1. Client timesheet emails with attachments\n2. Split PDF/Excel per file\n3. Extract text from each document\n4. AI extracts worker name, hours, dates\n5. Append to Timesheet_Intake sheet\n\nConfigure Gmail + Sheets credentials before activating."
            }
          }
        }
      }
    },
    {
      "id": "3e66487d-345d-4f60-86aa-d5659567390b",
      "name": "Gmail: Client Timesheet Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "maxResults": 5,
        "filters": {
          "q": "has:attachment (timesheet OR hours OR payroll) -label:Staffing/Processed",
          "readStatus": "unread"
        },
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      }
    },
    {
      "id": "43a1de7b-6798-44ad-8adb-226d650a1894",
      "name": "Has Attachments?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ Object.keys($binary || {}).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      }
    },
    {
      "id": "c0185e3b-65c6-4d57-8958-4ad78dafb57f",
      "name": "Split Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const output = [];\nfor (const item of $input.all()) {\n  const binary = item.binary || {};\n  const keys = Object.keys(binary).filter((k) => k.startsWith('attachment_'));\n  for (const key of keys) {\n    const file = binary[key];\n    const fileName = (file.fileName || '').toLowerCase();\n    const mime = (file.mimeType || '').toLowerCase();\n    output.push({\n      json: {\n        gmailMessageId: item.json.id,\n        threadId: item.json.threadId,\n        emailSubject: item.json.subject || '',\n        emailFrom: item.json.from || '',\n        emailDate: item.json.date || '',\n        attachmentKey: key,\n        fileName: file.fileName || key,\n        mimeType: mime,\n        fileExt: fileName.includes('.') ? fileName.split('.').pop() : '',\n      },\n      binary: { data: file },\n    });\n  }\n}\nreturn output;"
      }
    },
