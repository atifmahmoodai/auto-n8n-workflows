    {
      "id": "39863e90-e186-46e1-920d-02d664a04e06",
      "name": "Timesheet JSON Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1904,
        432
      ],
      "parameters": {
        "schemaType": "fromJson",
        "autoFix": true,
        "jsonSchemaExample": {
          "worker_name": "Jane Smith",
          "client_name": "Acme Warehouse",
          "pay_period_start": "2026-06-23",
          "pay_period_end": "2026-06-29",
          "total_hours": 38.5,
          "daily_entries": [
            {
              "date": "2026-06-23",
              "hours": 8
            },
            {
              "date": "2026-06-24",
              "hours": 7.5
            }
          ],
          "confidence_score": 0.91,
          "extraction_notes": "All dates within pay period.",
          "needs_manual_review": false
        }
      }
    },
    {
      "id": "a3a29884-52d7-4d54-b396-3db1d9c1c54f",
      "name": "Validate & Build Intake Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const src = $input.item.json;\nconst out = src.output || src;\nconst daily = Array.isArray(out.daily_entries) ? out.daily_entries : [];\nconst dailySum = daily.reduce((sum, d) => sum + (Number(d.hours) || 0), 0);\nconst totalHours = Number(out.total_hours) || dailySum;\nlet confidence = Number(out.confidence_score);\nif (Number.isNaN(confidence)) confidence = 0.5;\nconst needsReview = Boolean(out.needs_manual_review) || confidence < 0.85 || !out.worker_name || totalHours <= 0;\nconst intakeId = 'TS-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\nreturn {\n  json: {\n    intake_id: intakeId,\n    received_at: $now.toISO(),\n    gmail_message_id: src.gmailMessageId || $('Split Attachments').item.json.gmailMessageId,\n    email_from: src.emailFrom || $('Split Attachments').item.json.emailFrom,\n    email_subject: src.emailSubject || $('Split Attachments').item.json.emailSubject,\n    attachment_name: src.fileName || $('Split Attachments').item.json.fileName,\n    extraction_method: src.extractionMethod || 'unknown',\n    worker_name: out.worker_name || '',\n    client_name: out.client_name || '',\n    pay_period_start: out.pay_period_start || '',\n    pay_period_end: out.pay_period_end || '',\n    total_hours: totalHours,\n    daily_entries_json: JSON.stringify(daily),\n    confidence_score: confidence,\n    extraction_notes: out.extraction_notes || '',\n    needs_manual_review: needsReview,\n    status: 'pending_reconcile',\n    flagged_reason: '',\n    reconciled_at: '',\n  },\n};"
      }
    },
