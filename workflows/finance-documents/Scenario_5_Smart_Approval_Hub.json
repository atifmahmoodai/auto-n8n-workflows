    {
      "id": "f2d2b152-de97-47a6-adda-fc7b958f39f0",
      "name": "Prepare Auto Execute",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const action = $('Parse Approval Action').first().json;\nconst row = $input.first()?.json || {};\nlet payload = row.payload || {};\nif (typeof payload === 'string') { try { payload = JSON.parse(payload); } catch (e) { payload = {}; } }\nconst approved = action.status === 'approved';\nconst isLead = String(row.event_type || '').toLowerCase() === 'lead_outreach';\nconst leadId = String(payload.lead_id || '').trim();\nreturn [{ json: {\n  ...action,\n  event_type: row.event_type || '',\n  auto_execute_lead: approved && isLead && Boolean(leadId),\n  lead_id: leadId,\n  payload,\n}}];"
      }
