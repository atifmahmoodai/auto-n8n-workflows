    {
      "id": "4a4813e9-4040-4ac1-95fc-b0e06e65d0f3",
      "name": "Parse Approval Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first()?.json || {};\nconst body = j.body && typeof j.body === 'object' ? j.body : j;\nconst action = String(body.action || j.query?.action || '').toLowerCase();\nconst approvalId = String(body.approval_id || j.query?.approval_id || '').trim();\nconst notes = String(body.notes || body.decision_notes || '').trim();\nif (!approvalId || !['approve','reject','edit'].includes(action)) {\n  return [{ json: { ok: false, error: 'approval_id and action (approve|reject|edit) required' } }];\n}\nreturn [{ json: { ok: true, approval_id: approvalId, action, notes, status: action === 'approve' ? 'approved' : (action === 'reject' ? 'rejected' : 'edit_requested'), decided_at: new Date().toISOString() } }];"
      }
    },
