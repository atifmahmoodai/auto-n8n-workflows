    {
      "id": "c10a6677-805d-4a8f-aaf8-188d88f23213",
      "name": "Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function clean(v){return String(v??'').trim();}\nconst items = $input.all();\nreturn items.map((item, idx) => {\n  const j = item.json || {};\n  const body = j.body && typeof j.body === 'object' ? j.body : j;\n  const approvalId = clean(body.approval_id) || ('appr_' + Date.now() + '_' + idx);\n  const priority = ['low','normal','high','urgent'].includes(clean(body.priority).toLowerCase()) ? clean(body.priority).toLowerCase() : 'normal';\n  return { json: {\n    approval_id: approvalId,\n    source_workflow: clean(body.source_workflow || body.workflow_name || 'unknown'),\n    event_type: clean(body.event_type || body.type || 'general'),\n    title: clean(body.title || body.subject || 'Approval needed'),\n    priority,\n    suggested_action: clean(body.suggested_action || body.recommended_action || ''),\n    payload: typeof body.payload === 'string' ? body.payload : JSON.stringify(body.payload || body.data || body),\n    status: 'pending',\n    created_at: new Date().toISOString(),\n  }};\n});"
      }
    },
    {
      "id": "65096601-1639-48c9-83b3-c1d6143d48f6",
      "name": "AI Summarize Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        520,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Summarize automation events for a busy operator. Return JSON with keys: summary (2-3 sentences), key_facts (array of 3-5 strings), suggested_action (one line), urgency (low|normal|high|urgent).' }, { role: 'user', content: 'Event: ' + JSON.stringify({ title: $('Normalize Event').item.json.title, event_type: $('Normalize Event').item.json.event_type, priority: $('Normalize Event').item.json.priority, payload: $('Normalize Event').item.json.payload.slice(0, 6000) }) } ] }) }}"
      }
    },
    {
      "id": "7b069d8e-6a8c-486d-b4bb-81e6cdeb0fc5",
      "name": "Merge Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const base = $('Normalize Event').item.json;\nlet ai = {};\ntry { ai = JSON.parse($json.choices?.[0]?.message?.content || '{}'); } catch (e) {}\nreturn { json: {\n  ...base,\n  summary: ai.summary || base.title,\n  key_facts: Array.isArray(ai.key_facts) ? ai.key_facts.join(' | ') : '',\n  suggested_action: ai.suggested_action || base.suggested_action || 'Review and decide',\n  urgency: ai.urgency || base.priority,\n}};"
      }
    },
