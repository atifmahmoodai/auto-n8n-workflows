              "value": "Invoices",
              "type": "string"
            },
            {
              "id": "dt",
              "name": "document_type",
              "value": "invoice",
              "type": "string"
            },
            {
              "id": "pid",
              "name": "patient_id",
              "value": "={{ $(\"Normalize Patient Metadata\").item.json.patient_id }}",
              "type": "string"
            },
            {
              "id": "inv",
              "name": "invoice_number",
              "value": "={{ $json.output?.invoice_number || $json.invoice_number }}",
              "type": "string"
            },
            {
              "id": "idate",
              "name": "invoice_date",
              "value": "={{ $json.output?.invoice_date || $json.invoice_date }}",
              "type": "string"
            },
            {
              "id": "tot",
              "name": "total",
              "value": "={{ $json.output?.total || $json.total }}",
              "type": "number"
            },
            {
              "id": "con",
              "name": "concept",
              "value": "={{ $json.output?.concept || $json.concept }}",
              "type": "string"
            },
            {
              "id": "conf",
              "name": "confidence",
              "value": "={{ $json.output?.confidence || $json.confidence || 0 }}",
              "type": "number"
            },
            {
              "id": "rf",
              "name": "renamed_file",
              "value": "={{ $json.output?.renamed_file || $json.renamed_file }}",
              "type": "string"
            },
            {
              "id": "ts",
              "name": "processed_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "1b8b290c-3e91-44ce-a07a-57ab4e635583",
      "name": "Append to Google Sheets",
