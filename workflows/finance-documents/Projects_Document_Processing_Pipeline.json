              "id": "err",
              "name": "status",
              "value": "review_required",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "error_message",
              "value": "Low confidence extraction - manual review needed",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "0ab995a7-4c38-45e8-b845-dfc6e4ed61c1",
      "name": "Respond Review Required",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        2080,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, status: \"review_required\", error_message: $json.error_message, confidence: $json.confidence } }}",
        "options": {
          "responseCode": 422
        }
      }
    },
    {
      "id": "908d778e-f9a1-42a0-af57-e106da69868c",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1820,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, status: $json.status || \"processed\", document_type: $json.document_type, renamed_file: $json.renamed_file, confidence: $json.confidence } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
