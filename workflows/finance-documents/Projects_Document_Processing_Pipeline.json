{
  "name": "Projects: Document Processing Pipeline",
  "nodes": [
    {
      "id": "d037aff4-40bd-4a30-a123-c2d68f967601",
      "name": "Sticky Note 380d69d5",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        752,
        992
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "Document Pipeline Architecture",
            "position": [
              -220,
              60
            ],
            "parameters": {
              "width": 560,
              "height": 280,
              "content": "MEDICAL DOCUMENT PROCESSING PIPELINE\n\n1. Webhook POST multipart (patient metadata + PDFs)\n2. Route signature sheet vs invoice\n3. OpenAI extracts structured fields (Spanish prompts)\n4. Rename file, append Google Sheets row\n5. Return JSON + flag errors\n\nReplace SharePoint node with Google Drive if needed."
            }
          }
        }
      }
    },
    {
      "id": "a364ab8a-4c21-475f-b8d3-660c493ca96a",
      "name": "Webhook: Document Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "medical/documents",
        "responseMode": "responseNode",
        "options": {
          "binaryData": true
        }
      },
      "webhookId": "3a452dc8-f4a9-46c6-9630-3583dea38014"
    },
    {
      "id": "a6fd526a-1648-4c19-91bb-2838ff5b6057",
      "name": "Normalize Patient Metadata",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "pid",
              "name": "patient_id",
              "value": "={{ $json.patient_id || $json.body?.patient_id || \"\" }}",
              "type": "string"
            },
            {
              "id": "pname",
              "name": "patient_name",
              "value": "={{ $json.patient_name || $json.body?.patient_name || \"\" }}",
              "type": "string"
            },
            {
              "id": "center",
              "name": "medical_center",
              "value": "={{ $json.medical_center || $json.body?.medical_center || \"\" }}",
              "type": "string"
            },
            {
              "id": "dtype",
              "name": "document_type",
              "value": "={{ $json.document_type || $json.body?.document_type || \"signature_sheet\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "8aecca65-5000-491f-b1b9-a753cca93868",
      "name": "Route Document Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "invoice",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.document_type }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "invoice"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "signature",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.document_type }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "signature_sheet"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Unknown"
        }
      }
    },
    {
      "id": "579b620a-1f2d-4836-98e0-5a9f94eb2352",
      "name": "AI: Extract Invoice",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        780,
        420
      ],
      "parameters": {
        "promptType": "define",
        "text": "Extrae de la factura: invoice_number, invoice_date, total, concept, referenced_patients, confidence (0-1), renamed_file segun convencion INV_YYYYMMDD_NUM.pdf. Responde en JSON estructurado.",
        "hasOutputParser": true
      }
    },
    {
      "id": "d764af9a-6198-423f-acf5-051b487cb325",
      "name": "GPT-4o Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        752,
        432
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.1
        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "92ca3a3b-e86f-4222-87f3-d9c06933b136",
      "name": "Invoice Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        784,
        224
      ],
      "parameters": {
        "schemaType": "fromJson",
        "autoFix": true,
        "jsonSchemaExample": {
          "invoice_number": "INV-2026-001",
          "invoice_date": "2026-01-15",
          "total": 1500,
          "concept": "Therapy sessions",
          "referenced_patients": [
            "Patient A"
          ],
          "confidence": 0.9,
          "renamed_file": "INV_20260115_001.pdf"
        }
      }
    },
