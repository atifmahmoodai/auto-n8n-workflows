{
  "name": "Lease Upload Abstract: PDF -> AI -> Lease_QA",
  "nodes": [
    {
      "id": "f32e2c7e-0883-4e41-86eb-df570ab221e4",
      "name": "Sticky Note 22bf8b2f",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1424,
        688
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "Enterprise Buyer Warning",
            "position": [
              -240,
              40
            ],
            "parameters": {
              "width": 560,
              "height": 320,
              "content": "RANK 16 — COMMERCIAL LEASE ABSTRACTION (5.5/10 WEAK)\n\nEnterprise buyers only. Long sales cycles, legal liability, incumbent tools.\nDo NOT pitch to SMB agencies without CRE broker relationships.\n\n1. Webhook POST lease/upload (multipart PDF)\n2. Extract PDF text AFTER upload only\n3. AI structured abstract (gpt-5-mini, retryOnFail)\n4. Append Lease_QA sheet — status=pending_review\n5. Mandatory human QA before broker delivery\n\nConfigure credentials before activating."
            }
          }
        }
      }
    },
    {
      "id": "b3483f8b-46f7-4d70-adc8-e5186c30bf43",
      "name": "Webhook: Lease Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lease/upload",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false,
          "binaryData": true
        }
      },
      "webhookId": "e4622383-ca9e-4655-b6e3-a6b429b632db"
    },
    {
      "id": "6a7b7803-85be-4d7a-b1ab-67482238cf74",
      "name": "Normalize Upload Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item;\nconst json = item.json;\nconst body = json.body || json;\nconst binary = item.binary || {};\nconst keys = Object.keys(binary);\nconst fileKey = keys.find((k) => k === 'data' || k === 'file' || k.startsWith('attachment')) || keys[0];\nconst file = fileKey ? binary[fileKey] : null;\nconst brokerEmail = (body.broker_email || body.email || json.broker_email || '').trim();\nconst brokerName = (body.broker_name || json.broker_name || '').trim();\nconst tenantName = (body.tenant_name || body.tenant || '').trim();\nconst propertyAddress = (body.property_address || body.address || '').trim();\nreturn {\n  json: {\n    abstract_id: 'LEASE-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase(),\n    received_at: $now.toISO(),\n    broker_name: brokerName,\n    broker_email: brokerEmail,\n    tenant_name: tenantName,\n    property_address: propertyAddress,\n    file_name: file ? (file.fileName || fileKey) : 'unknown.pdf',\n    mime_type: file ? (file.mimeType || 'application/pdf') : '',\n    has_binary: Boolean(file),\n  },\n  binary: file ? { data: file } : {},\n};"
      }
    },
    {
      "id": "5ed5d805-f423-41a0-b377-2df2b5b8765e",
      "name": "Has PDF Attachment?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.has_binary }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "2f8bb90e-f15e-4f27-a5e6-ee39f6b5b492",
