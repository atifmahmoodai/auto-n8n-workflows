      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "ai-prompt",
              "name": "aiPrompt",
              "value": "={{ \"BROKER: \" + ($json.broker_name || \"\") + \"\\nTENANT: \" + ($json.tenant_name || \"\") + \"\\nPROPERTY: \" + ($json.property_address || \"\") + \"\\nFILE: \" + ($json.file_name || \"\") + \"\\n\\nLEASE DOCUMENT TEXT:\\n\" + ($json.extractedText || \"\") }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "90fbb4e5-7f3e-461d-bf92-4430b205ac37",
      "name": "AI Lease Abstractor",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.aiPrompt }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a commercial real estate lease abstraction specialist. Extract tenant_name, landlord_name, property_address, base_rent_monthly, rent_escalation, lease_term_months, commencement_date, expiration_date, renewal_options, cam_charges, and termination_clauses from the lease text. Return only valid JSON matching the schema. Use ISO dates YYYY-MM-DD. Summarize options, CAM, and termination in plain English. If any field is unclear, note it in extraction_notes and lower confidence_score. Never invent dollar amounts or dates not supported by the document.",
          "maxIterations": 3
        }
      }
    },
    {
      "id": "ea1df98d-96b1-4b0b-b27d-97f28a82d497",
      "name": "GPT-5 Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1424,
        640
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "options": {
          "temperature": 0.1
        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
