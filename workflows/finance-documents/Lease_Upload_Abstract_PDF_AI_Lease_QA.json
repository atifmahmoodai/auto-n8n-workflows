    {
      "id": "7fd23453-e981-4659-a32c-0d9887828b60",
      "name": "Lease Abstract JSON Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1456,
        432
      ],
      "parameters": {
        "schemaType": "fromJson",
        "autoFix": true,
        "jsonSchemaExample": {
          "tenant_name": "Acme Retail LLC",
          "landlord_name": "Metro Properties Inc",
          "property_address": "1200 Commerce Blvd, Suite 400, Dallas TX 75201",
          "base_rent_monthly": 12500,
          "rent_escalation": "3% annual increase on anniversary",
          "lease_term_months": 60,
          "commencement_date": "2026-03-01",
          "expiration_date": "2031-02-28",
          "renewal_options": "One 5-year renewal at FMV with 6-month notice",
          "cam_charges": "Tenant pays pro-rata share of taxes, insurance, CAM; est. $4.20/sf/yr",
          "termination_clauses": "Early termination after year 3 with 6-month penalty rent",
          "confidence_score": 0.88,
          "extraction_notes": "Rent schedule on Exhibit B; CAM reconciled annually."
        }
      }
    },
    {
      "id": "6979ae0b-8a2d-4d9e-adf8-a4d65d1866d3",
      "name": "Normalize Abstract for QA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const src = $input.item.json;\nconst out = src.output || src;\nlet confidence = Number(out.confidence_score);\nif (Number.isNaN(confidence)) confidence = 0.5;\nconst abstractSummary = [\n  'TENANT: ' + (out.tenant_name || src.tenant_name || 'n/a'),\n  'LANDLORD: ' + (out.landlord_name || 'n/a'),\n  'PROPERTY: ' + (out.property_address || src.property_address || 'n/a'),\n  '',\n  'RENT: $' + (Number(out.base_rent_monthly) || 0).toLocaleString() + '/mo',\n  'ESCALATION: ' + (out.rent_escalation || 'n/a'),\n  'TERM: ' + (out.lease_term_months || 'n/a') + ' months',\n  'COMMENCEMENT: ' + (out.commencement_date || 'n/a'),\n  'EXPIRATION: ' + (out.expiration_date || 'n/a'),\n  '',\n  'OPTIONS: ' + (out.renewal_options || 'n/a'),\n  'CAM: ' + (out.cam_charges || 'n/a'),\n  'TERMINATION: ' + (out.termination_clauses || 'n/a'),\n].join('\\n');\nreturn {\n  json: {\n    abstract_id: src.abstract_id,\n    received_at: src.received_at,\n    broker_name: src.broker_name || '',\n    broker_email: src.broker_email || '',\n    tenant_name: out.tenant_name || src.tenant_name || '',\n    landlord_name: out.landlord_name || '',\n    property_address: out.property_address || src.property_address || '',\n    base_rent_monthly: Number(out.base_rent_monthly) || 0,\n    rent_escalation: out.rent_escalation || '',\n    lease_term_months: Number(out.lease_term_months) || 0,\n    commencement_date: out.commencement_date || '',\n    expiration_date: out.expiration_date || '',\n    renewal_options: out.renewal_options || '',\n    cam_charges: out.cam_charges || '',\n    termination_clauses: out.termination_clauses || '',\n    confidence_score: confidence,\n    extraction_notes: out.extraction_notes || '',\n    abstract_summary: abstractSummary,\n    file_name: src.file_name || '',\n    status: 'pending_review',\n    reviewed_at: '',\n    delivered_at: '',\n    brokerage_firm: 'REPLACE_WITH_BROKERAGE_FIRM_NAME',\n  },\n};"
      }
    },
