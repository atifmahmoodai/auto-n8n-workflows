    {
      "id": "71252fdd-7c25-4a75-af59-23d6eeda5646",
      "name": "Validate TIN & Required Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const p = $input.item.json.body || $input.item.json;\nconst vendorId = (p.vendor_id || p.vendorId || '').trim();\nconst vendorName = (p.vendor_name || p.vendorName || '').trim();\nconst vendorEmail = (p.vendor_email || p.vendorEmail || '').trim();\nconst businessName = (p.business_name || p.businessName || vendorName).trim();\nconst tin = (p.tin || p.tax_id || '').trim();\nconst address = (p.address || '').trim();\nconst formUrl = 'REPLACE_WITH_W9_FORM_URL';\n\nconst errors = [];\nif (!vendorEmail) errors.push('vendor_email is required');\nif (!businessName) errors.push('business_name is required');\nif (!address || address.length < 10) errors.push('address must be at least 10 characters');\nif (!tin) errors.push('tin is required');\n\nconst ssnPattern = /^\\d{3}-\\d{2}-\\d{4}$/;\nconst einPattern = /^\\d{2}-\\d{7}$/;\nconst tinDigits = tin.replace(/[^0-9]/g, '');\nlet normalizedTin = tin;\n\nif (tinDigits.length === 9) {\n  if (ssnPattern.test(tin) || einPattern.test(tin)) {\n    normalizedTin = tin;\n  } else if (tinDigits.length === 9 && !tin.includes('-')) {\n    normalizedTin = tinDigits.slice(0, 2) + '-' + tinDigits.slice(2);\n  }\n} else {\n  errors.push('tin must be SSN (xxx-xx-xxxx) or EIN (xx-xxxxxxx)');\n}\n\nif (tin && !ssnPattern.test(normalizedTin) && !einPattern.test(normalizedTin)) {\n  errors.push('tin format invalid — use xxx-xx-xxxx (SSN) or xx-xxxxxxx (EIN)');\n}\n\nconst isValid = errors.length === 0;\nconst status = isValid ? 'validated' : 'rejected';\nconst rejectionReason = errors.join('; ');\n\nconst correctionSubject = 'W-9 Correction Needed — ' + (businessName || vendorName || 'Vendor');\nconst correctionBody = [\n  'Hello,',\n  '',\n  'We could not validate your W-9 submission for the following reason(s):',\n  rejectionReason,\n  '',\n  'Please resubmit here: ' + formUrl,\n  vendorId ? ('Vendor reference: ' + vendorId) : '',\n  '',\n  'Thank you,',\n  'Accounts Payable',\n].filter(Boolean).join('\\n');\n\nreturn {\n  json: {\n    vendor_id: vendorId || ('VND-' + $now.toFormat('yyyyLLdd-HHmmss')),\n    vendor_name: vendorName || businessName,\n    vendor_email: vendorEmail,\n    business_name: businessName,\n    tin: isValid ? normalizedTin : tin,\n    address,\n    status,\n    is_valid: isValid,\n    rejection_reason: rejectionReason,\n    validated_at: isValid ? $now.toISO() : '',\n    requested_at: $now.toISO(),\n    correction_subject: correctionSubject,\n    correction_body: correctionBody,\n  },\n};"
      }
    },
