          "value": "REPLACE_WITH_SLACK_CHANNEL_ID"
        },
        "messageType": "text",
        "text": "={{ $json.digest_text }}",
        "otherOptions": {
          "includeLinkToWorkflow": true,
          "mrkdwn": true
        }
      },
      "webhookId": "5f4cb227-fa2a-4ed9-9d9e-2e93cb0b6787"
    }
  ],
