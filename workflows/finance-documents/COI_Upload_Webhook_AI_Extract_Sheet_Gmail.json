    {
      "id": "b8ddbba9-2868-4b2e-a93a-e65bb5b4475e",
      "name": "COI JSON Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1456,
        432
      ],
      "parameters": {
        "schemaType": "fromJson",
        "autoFix": true,
        "jsonSchemaExample": {
          "policy_number": "GL-88421",
          "carrier": "Hartford Insurance",
          "gl_limit": 1000000,
          "wc_limit": 1000000,
          "effective_date": "2026-01-01",
          "expiry_date": "2027-01-01",
          "insured_name": "ABC Electric LLC",
          "confidence_score": 0.91,
          "extraction_notes": "All fields clearly visible."
        }
      }
    },
    {
      "id": "ad609ee3-d7bf-4338-8e49-2ef175bff75a",
      "name": "Validate COI Rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const src = $input.item.json;\nconst out = src.output || src;\nconst glMin = 1000000;\nconst wcMin = 1000000;\nconst glLimit = Number(out.gl_limit) || 0;\nconst wcLimit = Number(out.wc_limit) || 0;\nconst expiry = out.expiry_date || '';\nconst expiryDt = DateTime.fromISO(expiry);\nconst daysToExpiry = expiryDt.isValid ? Math.floor(expiryDt.diff($now, 'days').days * -1) : -1;\nconst deficiencies = [];\nif (glLimit < glMin) deficiencies.push('GL limit below $1M minimum (found $' + glLimit.toLocaleString() + ')');\nif (wcLimit < wcMin) deficiencies.push('WC limit below $1M minimum (found $' + wcLimit.toLocaleString() + ')');\nif (!expiryDt.isValid) deficiencies.push('Expiry date missing or invalid');\nelse if (daysToExpiry < 0) deficiencies.push('Policy expired on ' + expiry);\nelse if (daysToExpiry <= 30) deficiencies.push('Policy expires within 30 days (' + expiry + ')');\nif (!out.policy_number) deficiencies.push('Policy number missing');\nif (!out.carrier) deficiencies.push('Carrier missing');\nif (!out.insured_name) deficiencies.push('Insured name missing');\nlet confidence = Number(out.confidence_score);\nif (Number.isNaN(confidence)) confidence = 0.5;\nif (deficiencies.length) confidence = Math.min(confidence, 0.7);\nconst needsReview = deficiencies.length > 0 || confidence < 0.85;\nreturn {\n  json: {\n    upload_id: src.upload_id,\n    received_at: src.received_at,\n    subcontractor_name: src.subcontractor_name || out.insured_name || '',\n    subcontractor_email: src.subcontractor_email || '',\n    trade: src.trade || '',\n    file_name: src.file_name || '',\n    policy_number: out.policy_number || '',\n    carrier: out.carrier || '',\n    gl_limit: glLimit,\n    wc_limit: wcLimit,\n    effective_date: out.effective_date || '',\n    expiry_date: expiry,\n    insured_name: out.insured_name || '',\n    confidence_score: confidence,\n    extraction_notes: out.extraction_notes || '',\n    deficiencies: deficiencies,\n    deficiency_text: deficiencies.join('; '),\n    has_deficiencies: deficiencies.length > 0,\n    compliance_status: deficiencies.length ? 'deficient' : 'compliant',\n    status: needsReview ? 'pending_review' : 'pending_review',\n    days_to_expiry: daysToExpiry,\n    gc_company: 'REPLACE_WITH_GC_COMPANY_NAME',\n    deficiency_email_subject: 'COI Deficiency Notice - ' + (out.insured_name || src.subcontractor_name || 'Subcontractor'),\n    deficiency_email_body: 'Hello,\\n\\n' + (src.subcontractor_name || 'Subcontractor') + ',\\n\\nWe reviewed your Certificate of Insurance and found the following deficiencies:\\n\\n' + deficiencies.map((d) => '- ' + d).join('\\n') + '\\n\\nPlease upload a corrected COI at your earliest convenience.\\n\\nThank you,\\n' + 'REPLACE_WITH_GC_COMPANY_NAME' + ' Compliance Team',\n  },\n};"
      }
    },
