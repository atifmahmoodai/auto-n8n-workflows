    {
      "id": "91f99238-881d-4cfd-9755-6edbda87c29e",
      "name": "AI COI Extractor",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.aiPrompt }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a construction COI (Certificate of Insurance) extraction specialist. Extract policy_number, carrier, gl_limit, wc_limit, effective_date, expiry_date, and insured_name from the document text. Return only valid JSON matching the schema. Use ISO dates YYYY-MM-DD. If any field is unclear, note it in extraction_notes and lower confidence_score. Never invent policy numbers.",
          "maxIterations": 3
        }
      }
    },
    {
      "id": "d6c83cb3-f60b-4931-b273-aa1139a8a9a5",
      "name": "GPT-5 Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1424,
