      "typeVersion": 1,
      "position": [
        1424,
        688
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "COI Upload Architecture",
            "position": [
              -220,
              60
            ],
            "parameters": {
              "width": 540,
              "height": 300,
              "content": "COI UPLOAD & EXTRACT\n\n1. Webhook POST coi/upload (multipart PDF)\n2. Extract PDF text\n3. AI structured extraction (human QA required)\n4. Code validates GL/WC limits + expiry rules\n5. AppendOrUpdate COI_Register sheet\n6. IF deficiencies -> Gmail deficiency notice to subcontractor\n\nConfigure credentials before activating."
            }
          }
        }
      }
    },
    {
      "id": "8c89a3ee-577a-4f38-a9bc-029002c1c588",
      "name": "Webhook: COI Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "coi/upload",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false,
          "binaryData": true
        }
      },
      "webhookId": "cb4c32da-9ba1-49fa-9ed3-daec076b29b7"
    },
    {
      "id": "c38cf58c-552f-4efa-af15-aeffc57754c4",
      "name": "Normalize Upload Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item;\nconst json = item.json;\nconst body = json.body || json;\nconst binary = item.binary || {};\nconst keys = Object.keys(binary);\nconst fileKey = keys.find((k) => k === 'data' || k === 'file' || k.startsWith('attachment')) || keys[0];\nconst file = fileKey ? binary[fileKey] : null;\nconst subEmail = (body.subcontractor_email || body.email || json.subcontractor_email || '').trim();\nconst subName = (body.subcontractor_name || body.insured_name || json.subcontractor_name || '').trim();\nconst trade = (body.trade || body.scope || '').trim();\nreturn {\n  json: {\n    upload_id: 'COI-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase(),\n    received_at: $now.toISO(),\n    subcontractor_name: subName,\n    subcontractor_email: subEmail,\n    trade: trade,\n    file_name: file ? (file.fileName || fileKey) : 'unknown.pdf',\n    mime_type: file ? (file.mimeType || 'application/pdf') : '',\n    has_binary: Boolean(file),\n  },\n  binary: file ? { data: file } : {},\n};"
      }
    },
    {
      "id": "2d6112cc-ca4a-4304-aab5-57fc4a4eba64",
      "name": "Has PDF Attachment?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.has_binary }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
