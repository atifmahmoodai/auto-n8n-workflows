              "id": "extracted-text",
              "name": "extractedText",
              "value": "={{ $json.text || \"\" }}",
              "type": "string"
            },
            {
              "id": "ai-prompt",
              "name": "aiPrompt",
              "value": "={{ \"CLIENT: \" + ($json.client_name || \"\") + \"\\nSITE: \" + ($json.site_address || \"\") + \"\\nDUE: \" + ($json.bid_due_date || \"\") + \"\\nSQFT: \" + ($json.square_footage || 0) + \"\\nFILE: \" + ($json.file_name || \"\") + \"\\n\\nRFP DOCUMENT TEXT:\\n\" + ($json.extractedText || \"\") }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "1a9b8ee4-8d2f-432a-ad9a-ec7e04e3c90a",
      "name": "AI: Bid Checklist & Scope",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.aiPrompt }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a commercial cleaning bid analyst. Extract scope summary and a structured bid preparation checklist from RFP documents. Flag deficiencies (missing scope details, unclear frequencies, access constraints). Estimate weekly labor hours if possible. Return only valid JSON. Never invent site details not in the document.",
          "maxIterations": 3
        }
      }
    },
    {
      "id": "ea7f9144-86f3-4074-9a05-3ee0a8715876",
      "name": "GPT-5 Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1200,
        640
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
