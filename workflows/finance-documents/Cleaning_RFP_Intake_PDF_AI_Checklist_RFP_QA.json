    {
      "id": "60c9b1df-03e4-4dd2-b23d-88b8a943c69d",
      "name": "RFP Bid Checklist Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1232,
        432
      ],
      "parameters": {
        "schemaType": "fromJson",
        "autoFix": true,
        "jsonSchemaExample": {
          "scope_summary": "Nightly janitorial for 45,000 sqft office building. Restrooms, break rooms, common areas.",
          "bid_checklist": [
            "Confirm square footage and floor types",
            "Identify restroom count and fixture types",
            "Note frequency: daily vs weekly deep clean",
            "List specialty services: carpet, window, floor wax",
            "Verify insurance/COI requirements",
            "Confirm bid submission format and deadline"
          ],
          "deficiencies": [
            "Window cleaning frequency not specified",
            "No after-hours access details"
          ],
          "estimated_labor_hours_weekly": 120,
          "confidence_score": 0.87,
          "has_deficiencies": true
        }
      }
    },
    {
      "id": "317d3315-b8fb-4f3f-9d03-784b945da095",
      "name": "Build RFP QA Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const src = $('Set PDF Context').item.json;\nconst out = $input.item.json.output || $input.item.json;\nconst checklist = Array.isArray(out.bid_checklist) ? out.bid_checklist : [];\nconst deficiencies = Array.isArray(out.deficiencies) ? out.deficiencies : [];\nlet confidence = Number(out.confidence_score);\nif (Number.isNaN(confidence)) confidence = 0.5;\nconst hasDeficiencies = deficiencies.length > 0 || Boolean(out.has_deficiencies);\nreturn {\n  json: {\n    rfp_id: src.rfp_id,\n    received_at: src.received_at,\n    client_name: src.client_name,\n    site_address: src.site_address,\n    bid_due_date: src.bid_due_date,\n    square_footage: src.square_footage,\n    contact_email: src.contact_email,\n    file_name: src.file_name,\n    scope_summary: out.scope_summary || '',\n    bid_checklist: checklist.join(' | '),\n    deficiencies: deficiencies,\n    deficiency_text: deficiencies.join('; '),\n    has_deficiencies: hasDeficiencies,\n    estimated_labor_hours_weekly: Number(out.estimated_labor_hours_weekly) || 0,\n    confidence_score: confidence,\n    status: 'pending_review',\n    reviewed_by: '',\n    reviewed_at: '',\n    bid_submitted_at: '',\n    company_name: src.company_name || 'REPLACE_WITH_CLEANING_COMPANY_NAME',\n    slack_text: (hasDeficiencies ? ':warning: RFP DEFICIENCIES FOUND\\n' : ':broom: New Cleaning RFP Parsed\\n') + '*RFP ID:* ' + src.rfp_id + '\\n*Client:* ' + (src.client_name || 'n/a') + '\\n*Site:* ' + (src.site_address || 'n/a') + '\\n*Due:* ' + (src.bid_due_date || 'n/a') + (hasDeficiencies ? '\\n*Gaps:* ' + deficiencies.join('; ') : '') + '\\nReview RFP_QA sheet before bidding.',\n  },\n};"
      }
    },
