            ],
            "parameters": {
              "width": 280,
              "height": 100,
              "content": "Uploads without PDF binary are rejected.\nReturn 400 manually if needed."
            }
          }
        }
      }
    },
    {
      "id": "15ffdede-db81-44ef-a925-0af3e1c0f005",
      "name": "Webhook: Cleaning RFP",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cleaning/rfp",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false,
          "binaryData": true
        }
      },
      "webhookId": "4719672e-db4e-4472-af6d-2afdd8413eb2"
    },
    {
      "id": "daa65a77-5b02-4d52-8629-db7b44c87663",
      "name": "Normalize RFP Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item;\nconst json = item.json;\nconst body = json.body || json;\nconst binary = item.binary || {};\nconst keys = Object.keys(binary);\nconst fileKey = keys.find((k) => k === 'data' || k === 'file' || k.startsWith('attachment')) || keys[0];\nconst file = fileKey ? binary[fileKey] : null;\nreturn {\n  json: {\n    rfp_id: 'RFP-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase(),\n    received_at: $now.toISO(),\n    client_name: String(body.client_name || body.company || json.client_name || '').trim(),\n    site_address: String(body.site_address || body.address || '').trim(),\n    bid_due_date: String(body.bid_due_date || body.due_date || '').trim(),\n    square_footage: Number(body.square_footage || body.sqft || 0) || 0,\n    contact_email: String(body.contact_email || body.email || '').trim(),\n    file_name: file ? (file.fileName || fileKey) : 'unknown.pdf',\n    has_binary: Boolean(file),\n    company_name: 'REPLACE_WITH_CLEANING_COMPANY_NAME',\n  },\n  binary: file ? { data: file } : {},\n};"
      }
    },
    {
      "id": "a9c61151-41fe-4eba-acdd-019f31fbc984",
      "name": "Has PDF Attachment?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.has_binary }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "d7230fba-5f0e-44a0-b371-0ff382aa81e3",
