              "name": "processedAtKarachi",
              "value": "={{ $now.setZone(\"Asia/Karachi\").toISO() }}",
              "type": "string"
            },
            {
              "id": "now-karachi-display",
              "name": "processedAtDisplay",
              "value": "={{ $now.setZone(\"Asia/Karachi\").toFormat(\"yyyy-LL-dd HH:mm\") }}",
              "type": "string"
            }
          ]
        }
      }
