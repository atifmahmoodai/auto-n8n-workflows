    {
      "id": "1a3ec769-975c-419f-b05f-d2b5a1cd5726",
      "name": "OpenAI - AI Dispatch Triage",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2140,
        320
      ],
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=Analyze this service complaint and return the structured JSON decision only.\n\nComplaint ID: {{ $json.complaintId }}\nDate Submitted: {{ $json.dateSubmitted }}\nProcessed At: {{ $json.processedAtDisplay }}\nCustomer: {{ $json.customerName }}\nPhone: {{ $json.phone }}\nArea: {{ $json.area }}\nAppliance: {{ $json.appliance }}\nComplaint Text: {{ $json.complaintText }}\nWarranty Status: {{ $json.warrantyStatus }}\nDrive Evidence Found: {{ $json.driveEvidenceFound }}\nDrive Evidence Name: {{ $json.driveFileName }}\nDrive Evidence URL: {{ $json.driveEvidenceUrl }}",
        "options": {
          "maxIterations": 3,
          "systemMessage": "You are an AI operations dispatcher for a home appliance repair company. Classify urgency strictly. Burning smell, sparks, smoke, or electrical risk is Critical. Refrigerator not cooling is High unless customer mentions food, medicine, children, or business loss, then Critical. Leakage is Medium unless severe or electrical risk, then High/Critical. Noise issues are Medium. Cosmetic issues are Low. Warranty customers get priority when urgency is High or Critical. Return concise operational language only."
        }
      }
    },
    {
      "id": "6aab9907-dc1d-4102-a6c7-6275bb9b3419",
      "name": "OpenAI - Dispatch Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        2120,
        560
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "responsesApiEnabled": true,
        "options": {
          "reasoningEffort": "low",
          "temperature": 0.2,
          "timeout": 60000,
          "maxRetries": 2
        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "e3602fae-0342-47b6-a5cb-79aba70264ae",
      "name": "Structured Dispatch JSON Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2320,
        560
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"priority\": \"Critical\", \"summary\": \"Customer reported electrical sparking and burning smell.\", \"issue_type\": \"electrical\", \"suggested_technician\": \"electrical senior technician\", \"sla_hours\": 2, \"customer_message\": \"Please switch off the appliance immediately. Our technician will contact you shortly.\", \"manager_action\": \"Assign senior technician immediately and call customer before dispatch.\", \"risk_reason\": \"Sparking and burning smell indicate possible electrical hazard.\" }",
        "autoFix": true
      }
    },
    {
      "id": "078496fc-2f74-450e-ae51-0f0d53ae2a99",
      "name": "Build Operational Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const complaint = $('Date & Time - Karachi Context').item.json;\nconst ai = $json.output ?? $json;\nconst slaHours = Number(ai.sla_hours ?? 12);\nconst processedAt = complaint.processedAtKarachi ? new Date(complaint.processedAtKarachi) : new Date();\nconst deadline = new Date(processedAt.getTime() + slaHours * 60 * 60 * 1000);\nconst priority = String(ai.priority ?? 'Medium');\nconst emoji = priority.toLowerCase() === 'critical' ? '🚨' : priority.toLowerCase() === 'high' ? '⚠️' : '🔧';\nconst deadlineText = deadline.toLocaleString('en-CA', { timeZone: 'Asia/Karachi', hour12: false }).replace(',', '');\n\nreturn {\n  json: {\n    ...complaint,\n    aiPriority: priority,\n    aiSummary: ai.summary ?? '',\n    issueType: ai.issue_type ?? 'unknown',\n    suggestedTechnician: ai.suggested_technician ?? 'general technician',\n    slaHours,\n    slaDeadline: deadlineText,\n    customerMessage: ai.customer_message ?? '',\n    managerAction: ai.manager_action ?? '',\n    riskReason: ai.risk_reason ?? '',\n    sheetStatus: 'AI Reviewed',\n    notificationSent: 'Yes',\n    managerDecision: 'Pending',\n    pushTitle: `${emoji} ${priority.toUpperCase()} SERVICE COMPLAINT - ${complaint.complaintId}`,\n    pushBody: `${emoji} ${priority.toUpperCase()} SERVICE COMPLAINT\\n\\nCustomer: ${complaint.customerName}\\nPhone: ${complaint.phone}\\nArea: ${complaint.area}\\nAppliance: ${complaint.appliance}\\nIssue: ${ai.summary ?? complaint.complaintText}\\nTechnician: ${ai.suggested_technician ?? 'general technician'}\\nSLA Deadline: ${deadlineText}\\nAction: ${ai.manager_action ?? 'Review and dispatch technician.'}`\n  }\n};"
      }
    },
    {
      "id": "158d278d-30ea-4ebc-afe2-054582fd8b37",
      "name": "Push Notification - Manager Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2720,
        320
