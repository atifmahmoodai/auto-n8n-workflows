      "parameters": {
        "method": "POST",
        "url": "https://ntfy.sh/atif-service-dispatch-alerts-20260626",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.pushTitle, message: $json.pushBody, priority: $json.aiPriority === \"Critical\" ? 5 : ($json.aiPriority === \"High\" ? 4 : 3), tags: [\"rotating_light\", \"technologist\", \"repair\"] }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 10000
        }
      }
