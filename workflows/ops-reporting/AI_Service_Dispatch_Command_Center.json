    {
      "id": "dbf6850a-b2b6-44d2-9193-f34259d87255",
      "name": "Normalize + Idempotency Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const clean = (v) => String(v ?? '').trim();\n\nreturn $input.all()\n  .map((item) => {\n    const row = item.json;\n    const complaintId = clean(row['Complaint ID'] ?? row.complaintId);\n    const status = clean(row.Status ?? row.status);\n    const notificationSent = clean(row['Notification Sent'] ?? row.notificationSent);\n\n    return {\n      json: {\n        ...row,\n        complaintId,\n        dateSubmitted: clean(row['Date Submitted'] ?? row.dateSubmitted),\n        customerName: clean(row['Customer Name'] ?? row.customerName),\n        phone: clean(row.Phone ?? row.phone),\n        area: clean(row.Area ?? row.area),\n        appliance: clean(row.Appliance ?? row.appliance),\n        complaintText: clean(row['Complaint Text'] ?? row.complaintText),\n        driveFileUrl: clean(row['Drive File URL'] ?? row.driveFileUrl),\n        warrantyStatus: clean(row['Warranty Status'] ?? row.warrantyStatus),\n        status,\n        notificationSent\n      }\n    };\n  })\n  .filter((item) => {\n    const status = item.json.status.toLowerCase();\n    const notificationSent = item.json.notificationSent.toLowerCase();\n    return item.json.complaintId && status === 'new' && !['yes', 'sent', 'true', '1'].includes(notificationSent);\n  });"
      }
    },
    {
      "id": "7803879a-fcc5-4ece-8abe-d53195eced32",
      "name": "Merge Complaint + Drive Evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const complaint = $('Loop One Complaint at a Time').item.json;\nconst drive = $json ?? {};\n\nreturn {\n  json: {\n    ...complaint,\n    driveEvidenceFound: Boolean(drive.id),\n    driveFileId: drive.id ?? '',\n    driveFileName: drive.name ?? '',\n    driveMimeType: drive.mimeType ?? '',\n    driveEvidenceUrl: drive.webViewLink ?? complaint.driveFileUrl ?? ''\n  }\n};"
      }
    },
    {
      "id": "78bdaee1-4f7e-4294-885c-18cfdca1b6dd",
