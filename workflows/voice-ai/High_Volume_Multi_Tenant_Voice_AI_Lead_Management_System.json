            "Transcript": "={{ $json.transcript }}",
            "Duration (seconds)": "={{ $json.duration }}",
            "Timestamp": "={{ $json.timestamp }}",
            "Lead Score": "={{ $json.leadScore }}",
            "Score Reason": "={{ $json.scoreReason }}",
            "Call Status": "={{ $json.callStatus }}"
          }
