      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        180
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const parsed = $('Parse Grok Response').item.json;\nreturn {\n  json: {\n    name: parsed.lead.name,\n    email: parsed.lead.email,\n    query: parsed.lead.query,\n    qualified: parsed.qualified,\n    score: parsed.score,\n    reason: parsed.reason,\n    script: parsed.personalized_script,\n    audio_url: $json.webViewLink || '',\n    status: 'processed',\n    created_at: new Date().toISOString(),\n    next_action: parsed.next_action,\n  },\n};"
      }
    },
