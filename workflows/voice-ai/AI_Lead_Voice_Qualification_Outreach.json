  "nodes": [
    {
      "id": "2b580b30-d2af-4e18-9513-6e8e9856a1ae",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-voice-bot",
        "responseMode": "responseNode"
      },
      "webhookId": "287e2a22-6eea-4c6d-99b0-e79a159398bc"
    },
    {
      "id": "b767424a-4d70-4d1e-8d7b-e7c847ff48ca",
      "name": "Grok Qualify + Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.x.ai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "nodeCredentialType": "xAiApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"grok-3-latest\", \"messages\": [ { \"role\": \"system\", \"content\": \"You are a ruthless lead qualifier for a service business. Analyze the incoming lead data. Output ONLY valid minified JSON with no extra text: {\\\"qualified\\\": boolean, \\\"score\\\": number (0-100), \\\"reason\\\": string, \\\"personalized_script\\\": string (short natural voice message offering value), \\\"next_action\\\": string}. Be direct and realistic.\" }, { \"role\": \"user\", \"content\": \"New lead data: \" + JSON.stringify($(\"Lead Webhook\").item.json.body || $(\"Lead Webhook\").item.json) } ], \"max_tokens\": 600, \"temperature\": 0.3 } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "id": "5b58a2ba-4ff5-4293-801f-f4a5adff2278",
      "name": "Parse Grok Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const webhookItem = $('Lead Webhook').first().json;\nconst lead = webhookItem.body || webhookItem;\nlet raw = $json.choices?.[0]?.message?.content || '';\nif (typeof raw === 'string') {\n  raw = raw.trim();\n  if (raw.startsWith('```')) {\n    raw = raw.replace(/^```(?:json)?\\n?/, '').replace(/\\n?```$/, '');\n  }\n}\nconst parsed = JSON.parse(raw);\nreturn {\n  json: {\n    qualified: !!parsed.qualified,\n    score: Number(parsed.score) || 0,\n    reason: parsed.reason || '',\n    personalized_script: parsed.personalized_script || '',\n    next_action: parsed.next_action || '',\n    lead: {\n      name: lead.name || 'Unknown',\n      email: lead.email || '',\n      query: lead.query || '',\n    },\n  },\n};"
      }
    },
    {
      "id": "97438165-27ca-4b94-937a-8ba0d9dc369b",
      "name": "IF Qualified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "qualify-check",
              "leftValue": "={{ $json.qualified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "1f63bc06-7923-4fb4-8716-d7058c2bcd03",
      "name": "ElevenLabs Voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        180
      ],
      "parameters": {
        "method": "POST",
