      "typeVersion": 1,
      "position": [
        1216,
        528
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Store data in Supabase database. Use this when the user wants to save data to the database, create records, or persist information.",
        "tableId": "={{ $fromAI('table_name', 'Name of the Supabase table', 'string') }}"
      }
    },
    {
      "id": "e83fd025-00e5-42ab-bc9a-72b8d35ddeb3",
      "name": "Pushover Tool",
      "type": "n8n-nodes-base.pushoverTool",
      "typeVersion": 1,
      "position": [
        1344,
        528
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Send push notifications via Pushover. Use this when the user wants to send a notification, alert, or push message to their device.",
        "userKey": "={{ $fromAI('user_key', 'Pushover user key', 'string') }}",
        "message": "={{ $fromAI('message', 'Notification message content', 'string') }}",
        "additionalFields": {
          "title": "={{ $fromAI('title', 'Notification title', 'string', 'Voice Assistant Alert') }}"
        }
      }
    },
