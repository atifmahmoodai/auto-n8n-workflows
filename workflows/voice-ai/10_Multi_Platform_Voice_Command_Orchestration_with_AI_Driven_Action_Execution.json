      "typeVersion": 2.4,
      "position": [
        1088,
        528
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Post messages to Slack channels. Use this when the user wants to notify the team, send a Slack message, or post to a channel.",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $fromAI('channel', 'Slack channel name or ID', 'string') }}"
        },
        "text": "={{ $fromAI('message', 'Message content to post', 'string') }}",
        "otherOptions": {}
      },
      "webhookId": "4acb142e-d39f-484a-a8d8-faf5d7fff417"
    },
    {
      "id": "d6197810-d801-4732-b4bc-3c8c27dbe32b",
