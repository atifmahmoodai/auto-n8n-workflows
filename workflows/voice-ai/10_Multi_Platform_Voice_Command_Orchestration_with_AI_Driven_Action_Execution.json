    {
      "id": "f6a8a7bc-025f-4f8e-984e-7d27b34d4b61",
      "name": "Voice Command AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        952,
        304
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "You are an intelligent voice assistant. Based on the user's voice command, determine the appropriate action and execute it using the available tools: Google Sheets for spreadsheet operations, Gmail for sending emails, Slack for team messaging, Supabase for database operations, and Pushover for notifications. After executing the action, provide a clear, concise voice-friendly response confirming what was done."
        }
      }
    },
    {
      "id": "f9d2854f-26f5-477d-93c4-2ee548a4c9e6",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        704,
        528
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o"
        },
        "builtInTools": {},
        "options": {
          "temperature": 0.3
        }
      },
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "id": "49f29cbb-dcca-4fd1-9c03-e555beb1a00f",
      "name": "Google Sheets Tool",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.7,
      "position": [
        832,
        528
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Add or update data in Google Sheets spreadsheets. Use this when the user wants to log data, create records, or update spreadsheet information.",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $fromAI('spreadsheet_id', 'The Google Sheets spreadsheet ID or URL', 'string') }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $fromAI('sheet_name', 'The name of the sheet/tab within the spreadsheet', 'string') }}"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": null
        },
        "options": {}
      }
    },
    {
      "id": "ab764d27-6c5c-4459-9110-2d37caa2745e",
      "name": "Gmail Tool",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.2,
      "position": [
        960,
        528
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Send emails via Gmail. Use this when the user wants to send an email, message someone, or communicate via email.",
        "sendTo": "={{ $fromAI('recipient', 'Email address of the recipient', 'string') }}",
        "subject": "={{ $fromAI('subject', 'Email subject line', 'string') }}",
        "message": "={{ $fromAI('message', 'Email body content', 'string') }}",
        "options": {}
      },
      "webhookId": "173b4568-c62d-4f61-831d-b8b50b198e0e"
    },
    {
      "id": "6a7574ae-be07-4fe9-a27a-5a02a71237b2",
