{
  "name": "PM After-Hours SMS Triage: Emergency vs Routine",
  "nodes": [
    {
      "id": "3801b09e-8e06-462b-8649-08649309f169",
      "name": "Sticky Note 4d2bacd2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "After-Hours Architecture",
            "position": [
              -220,
              60
            ],
            "parameters": {
              "width": 520,
              "height": 260,
              "content": "PM AFTER-HOURS TRIAGE\n\n1. Twilio inbound SMS from tenants\n2. Keyword classify: flood/leak/fire/no heat = emergency\n3. Append Ticket_Log sheet\n4. Emergency: SMS on-call vendor + Slack urgent\n5. Routine: queue in sheet (no immediate vendor dispatch)\n\nA2P 10DLC registration required for production SMS."
            }
          }
        }
      }
    },
    {
      "id": "b1c2d838-5dd7-4725-86b0-6f5d9c8ecbed",
      "name": "Twilio: Inbound SMS",
      "type": "n8n-nodes-base.twilioTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "com.twilio.messaging.inbound-message.received"
        ]
      },
      "webhookId": "e2df43ad-6cc3-4814-9779-d4314e90e764"
    },
    {
      "id": "8cdcd557-c90a-46a5-9167-18811873891f",
      "name": "Normalize SMS Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "from-phone",
              "name": "from_phone",
              "value": "={{ $json.From || $json.from || \"\" }}",
              "type": "string"
            },
            {
              "id": "to-phone",
              "name": "to_phone",
              "value": "={{ $json.To || $json.to || \"\" }}",
              "type": "string"
            },
            {
              "id": "body",
              "name": "message_body",
              "value": "={{ ($json.Body || $json.body || \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "msg-sid",
              "name": "message_sid",
              "value": "={{ $json.MessageSid || $json.message_sid || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "2646c75c-7cea-46c8-bc64-8f6fe19c269a",
      "name": "Classify Emergency vs Routine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const inbound = $input.item.json;\nconst body = (inbound.message_body || '').toLowerCase();\nconst emergencyKeywords = ['flood', 'flooding', 'leak', 'leaking', 'fire', 'smoke', 'no heat', 'no heating', 'frozen pipe', 'burst pipe', 'gas smell'];\nlet matchedKeyword = '';\nlet isEmergency = false;\n\nfor (const kw of emergencyKeywords) {\n  if (body.includes(kw)) {\n    isEmergency = true;\n    matchedKeyword = kw;\n    break;\n  }\n}\n\nconst ticketId = 'PM-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + (inbound.message_sid || '').slice(-6);\nconst priority = isEmergency ? 'emergency' : 'routine';\nconst queue = isEmergency ? 'on_call_dispatch' : 'routine_queue';\n\nreturn {\n  json: {\n    ticket_id: ticketId,\n    created_at: $now.toISO(),\n    from_phone: inbound.from_phone,\n    to_phone: inbound.to_phone,\n    message_sid: inbound.message_sid,\n    message_body: inbound.message_body,\n    priority,\n    queue,\n    is_emergency: isEmergency,\n    matched_keyword: matchedKeyword,\n    status: isEmergency ? 'dispatched' : 'queued',\n    vendor_notified: isEmergency ? 'pending' : 'n/a',\n    property_address: '',\n    unit: '',\n    notes: isEmergency ? 'Auto-classified emergency from SMS keywords' : 'Routine after-hours request queued for morning review',\n    vendor_sms: isEmergency\n      ? 'URGENT PM DISPATCH: ' + (inbound.message_body || '').slice(0, 200) + ' — Reply from ' + inbound.from_phone\n      : '',\n  },\n};"
      }
    },
