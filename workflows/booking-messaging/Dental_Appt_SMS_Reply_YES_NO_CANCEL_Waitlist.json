    {
      "id": "55359a65-c18f-44ef-b669-12780fdd91a5",
      "name": "Match Patient & Parse Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const inbound=$('Normalize SMS Payload').item.json; const body=(inbound.message_body||'').trim(); const bodyUp=body.toUpperCase(); const phone=inbound.from_phone; const practiceName='REPLACE_WITH_PRACTICE_NAME'; const norm=p=>String(p||'').replace(/\\D/g,'').slice(-10); const rows=$('Sheet: Read Appointments').all().map(i=>i.json); let appt=rows.filter(r=>!['cancelled','canceled','completed'].includes((r.status||'').toLowerCase())).find(r=>norm(r.patient_phone)===norm(phone)); if(!appt){return{json:{matched:false,from_phone:phone,reply_sms:practiceName+': No upcoming appointment found for this number.',patient_response:'unmatched',status:'unmatched',broadcast_waitlist:false}};} let response='unknown', status=appt.status||'scheduled', reply='', broadcast=false; if(bodyUp==='YES'||bodyUp==='Y'){response='yes';status='confirmed';reply=practiceName+': Thanks! Appointment confirmed.';} else if(bodyUp==='NO'||bodyUp==='N'){response='no';status='reschedule_requested';reply=practiceName+': We will call to reschedule.';} else if(bodyUp.includes('CANCEL')){response='cancel';status='cancelled';broadcast=true;reply=practiceName+': Appointment cancelled. Waitlist will be notified.';} else {reply=practiceName+': Reply YES, NO, or CANCEL.';} return{json:{...appt,matched:true,from_phone:phone,patient_response:response,status,reply_sms:reply,broadcast_waitlist:broadcast,response_at:$now.toISO()}};"
      }
    },
    {
      "id": "356fb28e-198c-4eb1-a3a3-6f82183e69de",
      "name": "Sheet: Update Appointment",
