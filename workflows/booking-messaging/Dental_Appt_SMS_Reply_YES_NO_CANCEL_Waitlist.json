    {
      "id": "ca5c74d5-3960-40f5-aac3-04fe347b0fb5",
      "name": "Build Waitlist SMS List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const appt=$('Sheet: Update Appointment').item.json; const practiceName='REPLACE_WITH_PRACTICE_NAME'; const waitlist=$('Sheet: Read Waitlist').all().map(i=>i.json).filter(w=>(w.status||'active')==='active'&&(w.patient_phone||'').trim()); const msg=practiceName+': An appointment opened on '+(appt.appt_date||'soon')+'. Reply YES to claim.'; return waitlist.map(w=>({json:{patient_phone:w.patient_phone,sms_message:'Hi '+(w.patient_name||'there')+', '+msg}}));"
      }
    },
