{
  "name": "HVAC Missed Call Rescue: Twilio -> SMS -> Sheet",
  "nodes": [
    {
      "id": "2728de75-4891-407a-bc5a-6360d036f8be",
      "name": "Sticky Note d7cc7444",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "content": {
          "config": {
            "name": "Missed Call Architecture",
            "position": [
              -220,
              60
            ],
            "parameters": {
              "width": 520,
              "height": 260,
              "content": "HVAC MISSED CALL RESCUE\n\n1. Twilio voice status callback (no-answer/busy)\n2. Instant SMS within 30 seconds\n3. Log lead in Google Sheets pipeline\n4. Slack alert to owner\n\nNiche: HVAC emergency speed-to-lead\nConfigure Twilio status callback URL to this webhook."
            }
          }
        }
      }
    },
    {
      "id": "7d7a11ea-7bcd-4402-b74a-82cb85a1163e",
      "name": "Twilio: Voice Status Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "twilio/hvac-voice-status",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "webhookId": "9bd8324e-eb09-4e30-9af8-1d7b5fd0eab2"
    },
    {
      "id": "badb51d4-2da3-42eb-af67-a7e4b26979a5",
      "name": "Missed Inbound Call?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        240,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ ($json.Direction || $json.direction || \"inbound\").toLowerCase() }}",
              "rightValue": "inbound",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ [\"no-answer\",\"busy\",\"failed\",\"canceled\"].includes(($json.CallStatus || $json.call_status || \"\").toLowerCase()) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "92fca28c-b1dc-4aba-9535-c2a289b4ab65",
      "name": "Build Lead Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const p = $input.item.json;\nconst caller = p.From || p.from || '';\nconst called = p.To || p.to || '';\nconst callSid = p.CallSid || p.call_sid || ('CALL-' + Date.now());\nconst company = 'REPLACE_WITH_HVAC_COMPANY_NAME';\nconst leadId = 'HVAC-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + callSid.slice(-6);\nreturn {\n  json: {\n    lead_id: leadId,\n    created_at: $now.toISO(),\n    caller_phone: caller,\n    called_number: called,\n    call_sid: callSid,\n    call_status: (p.CallStatus || p.call_status || '').toLowerCase(),\n    direction: 'inbound',\n    vertical: 'HVAC',\n    lead_source: 'missed_call',\n    qualify_step: 0,\n    pipeline_status: 'new',\n    issue_type: 'unknown',\n    service_address: '',\n    preferred_time: '',\n    last_message: '',\n    sms_sent_at: '',\n    sms_reply_count: 0,\n    hubspot_contact_id: '',\n    hubspot_deal_id: '',\n    estimated_job_value: 800,\n    owner_notified: 'pending',\n    notes: 'Auto-created from missed call',\n    sms_body: 'Sorry we missed you at ' + company + ' HVAC! AC/heat emergency? Reply YES or NO. Reply STOP to opt out.',\n  },\n};"
      }
    },
    {
      "id": "2035d09d-3412-492e-a356-049577312db3",
      "name": "Twilio: Send Rescue SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "REPLACE_WITH_TWILIO_FROM_NUMBER",
        "to": "={{ $json.caller_phone }}",
        "message": "={{ $json.sms_body }}"
      }
    },
    {
      "id": "1624152b-38ae-4a02-857d-8f10fdd0b19d",
      "name": "Mark SMS Sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "sms-sent",
              "name": "sms_sent_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "pipeline",
              "name": "pipeline_status",
              "value": "sms_sent",
              "type": "string"
            }
          ]
        }
      }
    },
