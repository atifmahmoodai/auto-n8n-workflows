# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (they are not secrets).
EXPO_PUBLIC_API_URL=https://your-receipt-server.example.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx-ios.apps.googleusercontent.com
IOS_BUNDLE_ID=com.yourcompany.tally
ANDROID_PACKAGE=com.yourcompany.tally
