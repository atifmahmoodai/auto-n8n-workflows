PORT=3000
APP_TIMEZONE=Europe/London
# First admin account (only used when the database has no users yet)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-please
# Set to "production" behind HTTPS so session cookies get the Secure flag
NODE_ENV=development
# Twilio SMS (leave blank to simulate)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SendGrid email (leave blank to simulate)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
